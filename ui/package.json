{
  "name": "yukta-ui",
  "private": true,
  "version": "0.1.0-alpha.3",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.vitest.json && vite build && node scripts/check-bundle-size.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "api:types": "node scripts/generate-api-types.mjs",
    "icons": "node scripts/subset-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:headers": "node scripts/validate-headers.js",
    "test": "vitest",
    "test:e2e": "playwright test",
    "docs:screenshots": "node e2e/docs-screenshots/run.mjs",
    "docs:screenshots:check": "node e2e/docs-screenshots/run.mjs --check",
    "docs:screenshots:types": "tsc -p e2e/docs-screenshots/tsconfig.json",
    "test:e2e:shuffle": "playwright test --project=chromium --shuffle",
    "coverage": "vitest run --coverage && node scripts/open-coverage.js",
    "favicons": "bash scripts/generate-favicons.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "glob": "^14.0.3",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "material-symbols": "^0.48.3",
    "msw": "^2.15.0",
    "open": "^11.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "react": "^19.3.1",
    "recharts": "^3.0.0",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
