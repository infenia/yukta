{
  "sessionId": "example-05-data-pipeline",
  "name": "Data pipeline",
  "description": "Split a batch of records, keep the active ones, reshape them and write them out.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": { "example": "05-data-pipeline" },
  "workflows": {
    "etl": {
      "workflowId": "etl",
      "description": "Extract a batch, split it, filter, transform, load",
      "nodes": [
        {
          "nodeId": "extract",
          "type": "CONSTANT_SOURCE",
          "config": {
            "variables": {
              "records": [
                { "id": 1, "name": "Ada", "active": true },
                { "id": 2, "name": "Grace", "active": false },
                { "id": 3, "name": "Linus", "active": true }
              ]
            }
          }
        },
        { "nodeId": "split", "type": "SPLITTER", "config": { "itemsPath": "payload.records" } },
        { "nodeId": "keep-active", "type": "FILTER", "config": { "condition": "payload.active == true" } },
        {
          "nodeId": "shape",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": { "userId": "payload.id", "label": "'user:' + payload.name" }
          }
        },
        { "nodeId": "load", "type": "CONSOLE_TERMINAL", "config": {} }
      ],
      "edges": [
        { "source": "extract", "target": "split" },
        { "source": "split", "target": "keep-active" },
        { "source": "keep-active", "target": "shape" },
        { "source": "shape", "target": "load" }
      ]
    }
  }
}
