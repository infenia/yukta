# Grading settings of issue 1207 (controlbus watch --quiet: WARN lines use up the ERROR's 20-line cap).
# eval.sh sources this file. The commands run inside the finished clone (arm A) or issue worktree (arm B).
MODULE=cli                                                              # the module the issue is about; arm A's check scope, split.sh's "own module"
HIDDEN_DEST=cli/internal/commands/controlbus/zz_hidden_test.go          # where hidden_test.go is copied for grading, then removed
HIDDEN_CMD='cd cli && go test ./internal/commands/controlbus/ -run TestHidden -count=1'
SUITE_CMD='cd cli && go test ./... -count=1'
