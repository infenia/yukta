#!/usr/bin/env bash
# yk: develop Yukta with Yukta. Every Gradle run of this repo goes through the `tool` Yukta workflow on the dev
# server (built from origin/main, port 9858, started on demand).
#
#   yk gradle [--detach] <gradle args...>    run Gradle once, e.g. :core:test --tests X
#   yk check [--full] [--base REF] [--stage a,b] [--skip a,b] [--no-heal] [--detach]  the scoped, self-healing gate: yk plan's stages one after the other; a failure is
#                                            fixed (free fix, then a System One triage picks model and effort) or stops the run (--no-heal: at once)
#   yk plan [--full] [--base REF]            dry run: the stages a scoped check of your changes would run, nothing is executed
#   yk advise [--base REF] [--no-model]      recommends a test tier for your changes: a floor from the paths, which the decision model can only widen
#   yk stats [--decisions]                   (--decisions: the decision model in shadow mode, agreement and calibration per decision)
#   yk stats                                 runs, failed, median wall and heal dollars per kind of run; fix rate and dollars per stage and rung (from the heal events)
#   yk heal report|analyze|show [--since 7d] [--run ID] [--project NAME] [--json]
#                                            what heal did: where the time and money went, what looks wrong, the raw events
#   yk detail <session> <execution> [--grep P] [--tail N] [--head N]  the full output of the stage that failed a run (the MORE line says so)
#   yk bench [--runs N] [--max-ratio R] [--check] [args]  the same Gradle work direct and through yk: wall times and ratio (exit 1 above R and +3 s)
#   yk decision                              probe the optional decision model (decisions.json, YUKTA_DECISION_MODEL/_URL/off); yk status shows the same line
#   yk tool [--detach] [-C dir] <cmd...>     run any other command once, e.g. -C ui pnpm lint | -C cli go test ./...
#   (check, gradle, tool) --detach --notify  also post the RESULT into the Claude Code session that started the run when it ends (YUKTA_NOTIFY=off: never)
#
# A run's last line is machine readable; exit 0 only on success:
#   RESULT status=<S> failed_node=<node|-> healed=<stage:step,..|-> execution=<id> session=<id> wall=<s> cost=$<heal spend> bytes=<shown to you>
#
# Rebuild step 1: the other commands still work but are not advertised. The full usage text is in
# backup/yk.full.sh; restore it step by step (see backup/README.md).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$here/scripts/_lib.sh"
use_dev_key

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; }

cmd_up() {
  local args=() bg=0
  while (($#)); do
    case "$1" in
      --background) bg=1; shift ;;
      --release) args+=(--release); shift; [[ $# -gt 0 && "$1" != --* ]] && { args+=("$1"); shift; } ;;
      *) die "unknown option '$1' (yk up [--background] [--release [tag]])" ;;
    esac
  done
  if ((bg)); then
    mkdir -p "$DEV_HOME"
    if ! flock -n "$DEV_HOME/up.lock" true 2>/dev/null; then echo "yk up: already in progress"; return 0; fi
    setsid "${BASH_SOURCE[0]}" up "${args[@]}" >"$DEV_HOME/up.log" 2>&1 </dev/null &
    echo "yk up: running in the background (log: $DEV_HOME/up.log)"
    return 0
  fi
  server_up "${args[@]}"
}

cmd_down() {
  if ours; then server_stop; echo "stopped the dev server"; else echo "no dev server started by yk"; fi
}

# yk decision: probe the optional decision model (see decisions.json); 0 when it works
cmd_decision() { YK_DECISION_FRESH=1 decision_probe; }

cmd_status() {
  local main="" building=""
  main="$(git -C "$DEV_HOME/main" rev-parse "${YUKTA_DEV_MAIN_REF:-origin/main}" 2>/dev/null || true)"
  [[ ! -e "$DEV_HOME/up.lock" ]] || flock -n "$DEV_HOME/up.lock" true 2>/dev/null || building=" (yk up in progress, log: $DEV_HOME/up.log)"
  if ! healthy; then
    echo "down: $DEV_URL$building"
    return 3
  fi
  if ! ours; then
    echo "up: $DEV_URL, not started by yk"
    return 0
  fi
  local sha state=current
  sha="$(server_env YUKTA_DEV_SHA)"
  if [[ "$(server_env YUKTA_DEV_KIND)" == main && -n "$main" && "$main" != "$sha" ]]; then
    state="stale (origin/main is ${main:0:9}$([[ -s "$DEV_HOME/builds/$main/yukta.jar" ]] && echo ", built; swaps when idle" || true))"
  fi
  echo "up: $DEV_URL $(server_env YUKTA_DEV_LABEL) $state, running=$(busy)$building"
  echo "log: $DEV_HOME/server.log"
}

# run_tool MODE PROJECT ARGS...: one run of the `tool` workflow in this checkout's session: ARGS are the command
# (YK_TOOL=gradle: ./gradlew ARGS; YK_TOOL=tool: ARGS as they are), every argument shell-quoted.
run_tool() {
  local mode="$1" project="$2"
  shift 2
  need jq
  ensure_server
  # tmp is global: the EXIT trap runs after this function's locals are gone.
  local cli session cmdline label exec_id
  cli="$(find_cli)"
  mkdir -p "$STATE_DIR"
  # no lock: yk gradle and yk tool do not edit the checkout, and the server's tool concurrency group queues them (QUEUED in yk tree)
  session="$(check_session)"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  if [[ "${YK_TOOL:-gradle}" == gradle ]]; then cmdline="./gradlew $(printf '%q ' "$@")-q --console=plain" label=gradle
  else cmdline="$(printf '%q ' "$@")" label="$1"; fi
  render_session "$tmp/session.json"
  echo ">> server $YUKTA_SERVER_URL, session $session, project $project" >&2
  "$cli" session apply "$tmp/session.json" >"$tmp/apply.out" 2>&1 \
    || { cat "$tmp/apply.out" >&2; die "session apply failed"; }
  # a CLI built before 'session apply' existed prints the session help and exits 0
  ! grep -q "Available Commands" "$tmp/apply.out" || die "stale CLI (session apply printed help); run yk up"
  exec_id="$("$cli" -o json workflow start "$session" tool \
    --payload "$(jq -nc --arg p "$project" --arg c "$cmdline" --arg l "$label" '{project: $p, command: $c, timeout: 3600, label: $l}')" \
    | jq -r '.data.executionId // .executionId')"
  [[ -n "$exec_id" && "$exec_id" != null ]] || die "could not start workflow"
  echo "STARTED execution=$exec_id session=$session"
  [[ "${YK_NOTIFY:-}" != 1 ]] || YUKTA_PROJECT="$project" YUKTA_SCOPE="args:$(printf '%.60s' "$*")" start_notifier "$session" "$exec_id"
  [[ "$mode" == detach ]] && return 0
  YUKTA_PROJECT="$project" YUKTA_SCOPE="args:$(printf '%.60s' "$*")" watch_owned "$session" "$exec_id"
}

# start_notifier SESSION EXECUTION: with --notify, a detached `yk _notify` follows the run and posts into the Claude Code session that started it
# (the approvals while it runs, the RESULT when it ends). Its output goes to .yukta-dev/notify-<execution>.log.
start_notifier() {
  if [[ -z "${CLAUDE_CODE_MESSAGING_SOCKET:-}" ]]; then
    echo "notify: not started from a Claude Code session with cross-session messaging (no CLAUDE_CODE_MESSAGING_SOCKET); the run goes on without it" >&2
    return 0
  fi
  [[ "${YUKTA_NOTIFY:-on}" != off ]] || return 0
  mkdir -p "$STATE_DIR"
  setsid "${BASH_SOURCE[0]}" _notify "$1" "$2" >"$STATE_DIR/notify-$2.log" 2>&1 </dev/null &
}

# yk _notify SESSION EXECUTION (internal): follows the run like `yk watch`, posts each APPROVAL line at once and, when the run ends, the summary.
cmd_notify_run() {
  local session="${1:?session}" exec="${2:?execution}" log line
  log="$(mktemp)"
  trap "rm -f '$log'" EXIT  # expanded now: $log is local and gone when the trap runs
  cmd_watch "$session" "$exec" 2>&1 | while IFS= read -r line; do
    printf '%s\n' "$line"
    printf '%s\n' "$line" >>"$log"
    [[ "$line" != APPROVAL\ * ]] || notify_session "[yk] $line"
  done
  notify_session "$(notify_text "$session" "$exec" "$log")"
}

# yk check [--full] [--base REF] [--no-heal] [--models haiku,sonnet] [--triage off] [--detach [--notify]]
# The scoped, self-healing gate. scripts/plan.sh turns the changes into stage commands; the `check` workflow (scripts/gen-check.py)
# runs them one after the other through `tool`. A failing stage goes to `heal` (scripts/gen-heal.py): its free fix, then the
# System One triage rates the failure and picks the model and effort to start with, and fresh Claude sessions climb from there.
# --no-heal sends heal = "off": heal ends at once, so the first failing stage ends the run.
cmd_check() {
  local mode=watch plan_args=() heal=on fast=on models="" triage=on root plan cmds only="" skip="" notify=0
  while (($#)); do
    case "$1" in
      --detach) mode=detach; shift ;;
      --notify) notify=1; shift ;;
      --full) plan_args+=(--full); shift ;;
      --base) plan_args+=(--base "${2:?--base needs a ref}"); shift 2 ;;
      --no-heal) heal=off; shift ;;
      --no-fast) fast=off; shift ;;
      --stage) only="${2:?--stage needs stage names, e.g. tests,style}"; shift 2 ;;
      --skip) skip="${2:?--skip needs stage names, e.g. security}"; shift 2 ;;
      --models) models="${2:?--models needs models, e.g. haiku,sonnet}"; shift 2 ;;
      --triage) [[ "${2:-}" == off ]] || die "invalid --triage '${2:-}' (off)"; triage=off; shift 2 ;;
      *) die "unknown option '$1' (yk check [--full] [--base REF] [--stage a,b] [--skip a,b] [--no-heal] [--no-fast] [--models ..] [--triage off] [--detach [--notify]])" ;;
    esac
  done
  [[ -z "$models" || "$models" =~ ^(haiku|sonnet)(,(haiku|sonnet))*$ ]] || die "invalid --models '$models' (models from haiku, sonnet)"
  ((notify == 0)) || [[ "$mode" == detach ]] || die "--notify needs --detach: a run you wait for reports to you anyway"
  need jq
  root="$(git rev-parse --show-toplevel)"
  plan="$("$here/scripts/plan.sh" "${plan_args[@]}")" || die "yk plan failed"
  if [[ -n "$only$skip" ]]; then
    # --stage keeps only the named stages of the plan, --skip drops them (a name matches with - or _ either way, as yk plan prints it)
    plan="$(filter_plan "$only" "$skip" <<<"$plan")"
    grep -qv '^#' <<<"$plan" || die "no stage of the plan is left after --stage/--skip (yk plan shows the stages)"
  fi
  grep '^#' <<<"$plan" >&2 || true
  local session healdir events
  session="$(check_session)"
  healdir="$STATE_DIR/heal/$session"
  events="$(heal_events_file)"
  # Per stage of the check workflow (fixed in session.json), "" unless planned: cmd (its command), auto (its free fix, "-" for none) and
  # fmt (what formats the code after a fixer edited it: the formatter of the stage's ecosystem). A planned stage the workflow lacks
  # is a bug in plan.sh or gen-check.py.
  cmds="$(grep -v '^#' <<<"$plan" | jq -Rn --slurpfile s "$here/session.json" '
    ([$s[0].workflows.check.nodes[] | select(.type == "SUB_WORKFLOW" and .config.workflowId == "tool" and .nodeId != "verify") | .nodeId]) as $names
    | ([inputs | select(length > 0) | split("\t") | {stage: (.[0] | gsub("[.-]"; "_")), dir: .[1], cmd: .[2], auto: (.[3] // "")}]) as $rows
    | ($rows | map(.stage) - $names) as $bad
    | if ($bad | length) > 0 then error("stage not in the check workflow: \($bad | join(", "))") else . end
    | def full($r; $c): if $r.dir == "." then $c else "cd \($r.dir | @sh) && \($c)" end;
      ($rows | map({(.stage): full(.; .cmd)}) | add // {}) as $cmd
    | ($rows | map(select(.auto != "") | {(.stage): full(.; .auto)}) | add // {}) as $auto
    | def fmt($n): if ($n | startswith("cli_")) then ($auto.cli_fmt_check // "-") elif ($n | startswith("ui_")) then ($auto.ui_prettier // "-")
        elif ($n | IN("reuse", "actionlint", "docs")) then "-" else ($auto.spotless // "-") end;
      {cmd: (($names | map({(.): ""}) | add) + $cmd),
       auto: ($names | map({(.): ($auto[.] // "-")}) | add),
       fmt: ($names | map({(.): fmt(.)}) | add),
       verifyTasks: ([$rows[] | select(.cmd | startswith("./gradlew ")) | .cmd | split(" ")[1:][] | select(startswith("-") | not)] | unique | join(" "))}')" \
    || die "cannot build the stage commands"
  if [[ "$(jq '[.cmd[] | select(. != "")] | length' <<<"$cmds")" == 0 ]]; then
    echo "nothing to check"
    return 0
  fi
  ensure_server
  local cli exec_id modules
  cli="$(find_cli)"
  modules="$(sed -n 's/^# modules: //p' <<<"$plan" | head -1)"
  mkdir -p "$STATE_DIR"
  # only a healing check edits the checkout, so only it excludes another one (a --no-heal check and yk gradle queue on the server instead)
  if [[ "$heal" == on ]]; then
    exec 8>"$STATE_DIR/check.lock"
    flock -n 8 || die "another healing check is running in this checkout (execution $(cat "$STATE_DIR/check.holder" 2>/dev/null || echo unknown)); wait for it (yk watch) or stop it, or use --no-heal"
  fi
  rm -rf "$healdir.prev"; [[ ! -d "$healdir" ]] || mv "$healdir" "$healdir.prev"; mkdir -p "$healdir"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  render_session "$tmp/session.json"
  echo ">> server $YUKTA_SERVER_URL, session $session, project $root" >&2
  "$cli" session apply "$tmp/session.json" >"$tmp/apply.out" 2>&1 || { cat "$tmp/apply.out" >&2; die "session apply failed"; }
  exec_id="$("$cli" -o json workflow start "$session" check --payload "$(jq -nc --arg p "$root" --arg d "$healdir" --arg ev "${events:--}" --arg m "${modules:--}" \
      --arg models "${models:--}" --arg heal "$heal" --arg triage "$triage" --arg rules "$here/fixer-rules.md" \
      --arg budget "${YUKTA_BUDGET_CHECK:-$(jq -r '.checkBudget' "$here/heal.json")}" --arg fast "$fast" --arg bin "${YUKTA_CLAUDE_BIN:--}" --arg tmodel "${YUKTA_TRIAGE_MODEL:-$(jq -r '.triage.model' "$here/heal.json")}" \
      --arg turl "${YUKTA_TRIAGE_URL:-$(jq -r '.triage.url' "$here/heal.json")}" --argjson c "$cmds" '
      {project: $p, timeout: 3600, healDir: $d, events: $ev, modules: $m, models: $models, heal: $heal, triage: $triage,
       rules: $rules, claudeBin: $bin, budgetCheck: $budget, triageModel: $tmodel, triageUrl: $turl,
       verifyCommand: (if $c.verifyTasks == "" then "true" else "./gradlew --continue \($c.verifyTasks) -q --console=plain" end),
       cmd: $c.cmd, auto: $c.auto, fmt: $c.fmt,
       # fast path: all Gradle tasks in one invocation (two or more Gradle stages planned); its pass leaves a marker that turns the Gradle stages of the chain into no-ops
       fast: (if $fast == "on" and ([$c.cmd[] | select(startswith("./gradlew "))] | length) > 1 then "./gradlew --continue \($c.verifyTasks) -q --console=plain && touch \(($d + "/fast.ok") | @sh)" else "" end),
       chain: ($c.cmd | map_values(if startswith("./gradlew ") then "test -f \(($d + "/fast.ok") | @sh) || \(.)" else . end))}')" \
    | jq -r '.data.executionId // .executionId')"
  [[ -n "$exec_id" && "$exec_id" != null ]] || die "could not start the check"
  [[ "$heal" != on ]] || echo "$exec_id" >"$STATE_DIR/check.holder"
  echo "STARTED execution=$exec_id session=$session"
  ((notify == 0)) || YUKTA_FAILED_OUTPUT=1 YUKTA_PROJECT="$root" YUKTA_SCOPE=check start_notifier "$session" "$exec_id"
  [[ "$mode" == detach ]] && return 0
  YUKTA_FAILED_OUTPUT=1 YUKTA_PROJECT="$root" YUKTA_SCOPE=check watch_owned "$session" "$exec_id"
}

# yk gradle ARGS: ./gradlew ARGS in the checkout. yk tool [-C dir] CMD ARGS: any command in dir (relative to the
# checkout root, default the root). Both are one run of the tool workflow; every argument is shell-quoted.
cmd_gradle() {
  local mode=watch notify=0
  while (($#)); do
    case "$1" in
      --detach) mode=detach; shift ;;
      --notify) notify=1; shift ;;
      *) break ;;
    esac
  done
  (($#)) || die "usage: yk gradle [--detach [--notify]] <gradle args...>"
  ((notify == 0)) || [[ "$mode" == detach ]] || die "--notify needs --detach: a run you wait for reports to you anyway"
  YK_NOTIFY=$((notify)) YK_TOOL=gradle run_tool "$mode" "$(git rev-parse --show-toplevel)" "$@"
}

cmd_tool() {
  local mode=watch root dir notify=0
  root="$(git rev-parse --show-toplevel)" dir="$root"
  while (($#)); do
    case "$1" in
      --detach) mode=detach; shift ;;
      --notify) notify=1; shift ;;
      -C) dir="$(cd "$root" && cd "${2:?-C needs a folder}" && pwd)" || die "no folder '$2'"; shift 2 ;;
      *) break ;;
    esac
  done
  (($#)) || die "usage: yk tool [--detach [--notify]] [-C dir] <command> [args...]"
  ((notify == 0)) || [[ "$mode" == detach ]] || die "--notify needs --detach: a run you wait for reports to you anyway"
  YK_NOTIFY=$((notify)) YK_TOOL=tool run_tool "$mode" "$dir" "$@"
}

# watch_owned SESSION EXECUTION: cmd_watch for a run this client started. The run ends with the client: Ctrl-C, or Claude Code stopping
# the background task (SIGTERM), stops the execution and the runs below it (a drain: work in progress gets up to 30 s). --detach is
# the way to let a run outlive its client. The watch runs in the background because bash only runs a trap between foreground commands.
watch_owned() {
  local e="$2" w
  cmd_watch "$@" &
  w=$!
  trap "trap - INT TERM; kill $w 2>/dev/null; echo 'interrupted: stopping $e and the runs below it' >&2; api POST '/api/executions/$e/stop?tree=true' >/dev/null 2>&1; record_stopped '$1' '$e'; exit 130" INT TERM
  wait "$w"
}

# record_stopped SESSION EXECUTION: the result event of a run its client stopped (the watch that would have written it is gone), so the
# run does not vanish from the log. Best effort: the progress it can still read, else an empty one.
record_stopped() {
  local progress
  progress="$("$(find_cli)" -o json workflow status "$1" "$2" 2>/dev/null | jq -c '(.data // .)' 2>/dev/null)" || progress=""
  [[ -n "$progress" ]] || progress='{"tasks":[]}'
  emit_result "$1" "$2" STOPPED - - "$progress" || true
}

# cmd_watch SESSION EXECUTION [--all|--stages]: follows a run until it ends, problems only (--all: every event; --stages: also one
# "STAGE <name> finished" line per stage that ran, and "STAGE <name>.heal finished" per heal, so a Monitor sees progress on a clean run), then SLOW lines and the
# RESULT line.
cmd_watch() {
  local session="${1:?usage: yk watch <session> <execution> [--all|--stages]}" target="${2:?usage: yk watch <session> <execution> [--all|--stages]}"
  local filter=(--quiet) progress="" shown
  shown="$(mktemp)"
  [[ "${3:-}" == --all ]] && filter=()
  export YUKTA_SERVER_URL="${YUKTA_SERVER_URL:-$DEV_URL}"
  # a checkpoint that waits for an answer is news too: say so, once, while the run is watched
  announce_signals "$target" 8>&- &
  local announcer=$!
  if [[ "${3:-}" == --stages ]]; then
    ("$(find_cli)" controlbus watch --execution "$target" --until-done 2>/dev/null \
      | grep --line-buffered -E '^NODE ([a-z_]+|verify)(\.heal)? SUCCESS$' | grep --line-buffered -v -E '^NODE (trigger|done) ' \
      | sed -u 's/^NODE \(.*\) SUCCESS$/STAGE \1 finished/' | tee -a "$shown") 8>&- &
    progress=$!
  fi
  # A node that never ran (a rung nobody needed, or one behind the failure) is not news: the check has
  # dozens of them. ponytail: filtered here; belongs in the CLI's --quiet if other callers want it.
  "$(find_cli)" controlbus watch --execution "$target" --until-done "${filter[@]}" \
    | { if ((${#filter[@]})); then grep -v -E '^NODE [^ ]+ (SKIPPED|UPSTREAM_FAILED|CANCELLED)$|^(ERROR|WARN) (heal|attempt|claude|fix-from)/(trigger|heal\?|auto\?|brief|prepare|first|triage\?|report|fixed\?|carry\.[a-z]+):|^(ERROR|WARN) [^ ]+: (BUILD FAILED in .*|Process failed with exit code [0-9]+|WARNING: .*(sun\.misc\.Unsafe|Unsafe).*)$|^WARN [^ ]+: (\* Deprecated licenses: 0|Set `VITE_CONFIG_NATIVE_IGNORE_WARNING=true`.*)$'; else cat; fi; } | tee -a "$shown" || true
  YUKTA_WATCHED_BYTES="$(stat -c %s "$shown")"
  export YUKTA_WATCHED_BYTES
  rm -f "$shown"
  kill "$announcer" 2>/dev/null || true
  wait "$announcer" 2>/dev/null || true
  [[ -z "$progress" ]] || wait "$progress" 2>/dev/null || true
  record_durations "$session" "$target" "${YUKTA_SCOPE:--}"
  print_result "$session" "$target"
}

# announce_signals EXEC: prints "APPROVAL <signal> waits at <node>: yk approve <e> <signal>" once for each node
# of the tree of EXEC that starts waiting for a signal; runs until killed
announce_signals() {
  local seen="" line key
  while sleep 3; do
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      key="${line%% since*}"
      [[ "$seen" == *"|$key|"* ]] && continue
      seen+="|$key|"
      read -r e node name _ <<<"$line"
      echo "APPROVAL $name waits at $node: yk approve $e $name (or yk reject $e $name)"
    done < <( (cmd_signals "$1") 2>/dev/null || true)
  done
}

cmd_cli() {
  export YUKTA_SERVER_URL="${YUKTA_SERVER_URL:-$DEV_URL}"
  exec "$(find_cli)" "$@"
}

# ---- steering: the tree of runs, control and approvals (T0: the interactive session) ----

# api METHOD PATH: a call to the server with the key; prints the unwrapped data, or dies with the server's message
api() {
  local out code
  out="$(curl -sS -m 30 -w '\n%{http_code}' -X "$1" ${YUKTA_TOKEN:+-H "X-API-Key: $YUKTA_TOKEN"} "${YUKTA_SERVER_URL:-$DEV_URL}$2")" \
    || die "$1 $2: the server is not reachable (yk up)"
  code="${out##*$'\n'}"
  out="${out%$'\n'*}"
  ((code < 400)) || die "$1 $2: HTTP $code $(jq -r '.message // empty' <<<"$out" 2>/dev/null)"
  jq '(.data // .)' <<<"$out"
}

uri() { jq -rn --arg v "$1" '$v | @uri'; }

# resolve_exec ID: a full execution id, or the unique prefix of one (the tree prints eight characters)
resolve_exec() {
  local id="${1:?an execution id is required}" found
  ((${#id} >= 32)) && { echo "$id"; return; }
  found="$(api GET '/api/executions?limit=1000' | jq -r --arg p "$id" '[.[] | select(.executionId | startswith($p)) | .executionId] | unique | if length == 1 then .[0] else empty end')"
  [[ -n "$found" ]] || die "no single execution starts with '$id'"
  echo "$found"
}

# session_of EXEC: the session an execution runs in
session_of() { api GET '/api/executions?limit=1000' | jq -r --arg e "$1" '.[] | select(.executionId == $e) | .sessionId' | head -1; }

# pending SESSION...: the nodes that wait for a signal in these sessions, as a JSON array
pending() {
  local s all="[]"
  for s in "$@"; do all="$(jq -c --argjson a "$(api GET "/api/sessions/$s/approvals")" '. + $a' <<<"$all")"; done
  echo "$all"
}

cmd_tree() {
  local root runs all sessions cur="{}" id nodes
  root="$(resolve_exec "${1:?usage: yk tree <execution>}")"
  runs="$(api GET "/api/executions/$root/tree")"
  all="$(api GET '/api/executions?limit=1000')"
  mapfile -t sessions < <(jq -r --argjson r "$runs" '[.[] | select(.executionId as $i | $r | any(.executionId == $i)) | .sessionId] | unique[]' <<<"$all")
  for id in $(jq -r '.[] | select(.status | test("RUNNING|QUEUED|PAUSED")) | .executionId' <<<"$runs"); do
    # the status stays RUNNING while paused; the control state says PAUSED
    nodes="$(api GET "/api/executions/$id" | jq -c '{nodes: ([.tasks[] | select(.status | test("RUNNING|QUEUED|PAUSED")) | .nodeId] | join(",")), paused: (.controlState == "PAUSED")}')"
    cur="$(jq -c --arg i "$id" --argjson n "$nodes" '. + {($i): $n}' <<<"$cur")"
  done
  jq -r --argjson cur "$cur" --argjson appr "$(pending "${sessions[@]}")" '
    (map({(.executionId): .}) | add) as $by
    | def depth($r): if ($r.parentExecutionId // null) == null or $by[$r.parentExecutionId] == null then 0 else 1 + depth($by[$r.parentExecutionId]) end;
    .[] | . as $r
    | "\($r.executionId[:8]) \("  " * depth($r))\($r.workflowId) \($r.status)"
      + (if $cur[$r.executionId].paused? then " paused" else "" end)
      + (if ($cur[$r.executionId].nodes? // "") != "" then " [\($cur[$r.executionId].nodes)]" else "" end)
      + ([$appr[] | select(.executionId == $r.executionId) | " awaiting \(.name)@\(.nodeId)"] | join(""))' <<<"$runs"
}

# yk pause|resume|stop EXEC [--tree] [--now]   (--now: stop ends the run at once, mode KILL; without it the stop drains, up to 30 s)
cmd_run_control() {
  local verb="$1" exec tree=false mode=
  shift
  exec="$(resolve_exec "${1:?usage: yk $verb <execution> [--tree]}")"
  shift
  while (($#)); do
    case "$1" in
      --tree) tree=true; shift ;;
      --now) [[ "$verb" == stop ]] || die "--now is for yk stop"; mode=KILL; shift ;;
      *) die "unknown option '$1' (yk $verb <execution> [--tree]$([[ "$verb" == stop ]] && echo ' [--now]'))" ;;
    esac
  done
  api POST "/api/executions/$exec/$verb?tree=$tree${mode:+&mode=$mode}" >/dev/null
  echo "$verb: $exec$([[ "$tree" == true ]] && echo ' and the runs below it')"
}

# yk skip|unskip|retry EXEC NODE
cmd_node_control() {
  local verb="$1" exec node
  shift
  exec="$(resolve_exec "${1:?usage: yk $verb <execution> <node>}")"
  node="${2:?usage: yk $verb <execution> <node>}"
  case "$verb" in
    skip) api POST "/api/executions/$exec/nodes/$node/skip?skip=true" >/dev/null ;;
    unskip) api POST "/api/executions/$exec/nodes/$node/skip?skip=false" >/dev/null ;;
    retry) api POST "/api/executions/$exec/nodes/$node/retry" >/dev/null ;;
  esac
  echo "$verb: $exec $node"
}

# yk break EXEC NODE --field F --equals V | --clear
cmd_break() {
  local exec node field="" equals="" clear=0
  exec="$(resolve_exec "${1:?usage: yk break <execution> <node> --field F --equals V | --clear}")"
  node="${2:?usage: yk break <execution> <node> --field F --equals V | --clear}"
  shift 2
  while (($#)); do
    case "$1" in
      --field) field="${2:?--field needs a path}"; shift 2 ;;
      --equals) equals="${2:?--equals needs a value}"; shift 2 ;;
      --clear) clear=1; shift ;;
      *) die "unknown option '$1'" ;;
    esac
  done
  if ((clear)); then
    api DELETE "/api/executions/$exec/nodes/$node/breakpoint" >/dev/null
    echo "breakpoint cleared: $exec $node"
  else
    [[ -n "$field" && -n "$equals" ]] || die "yk break needs --field and --equals (or --clear)"
    api POST "/api/executions/$exec/nodes/$node/breakpoint?field=$(uri "$field")&equals=$(uri "$equals")" >/dev/null
    echo "breakpoint set: $exec $node when $field == $equals"
  fi
}

# yk step EXEC NODE on|off|next
cmd_step() {
  local exec node mode="${3:?usage: yk step <execution> <node> on|off|next}" path
  exec="$(resolve_exec "${1:?usage: yk step <execution> <node> on|off|next}")"
  node="${2:?usage: yk step <execution> <node> on|off|next}"
  case "$mode" in
    on) path=step/enable ;;
    off) path=step/disable ;;
    next) path=step ;;
    *) die "step takes on, off or next" ;;
  esac
  api POST "/api/executions/$exec/nodes/$node/$path" >/dev/null
  echo "step $mode: $exec $node"
}

# yk signals [EXEC]: what waits for a signal, in the tree of EXEC or in every session with a running run
cmd_signals() {
  local sessions all root=""
  [[ -z "${1:-}" ]] || root="$(resolve_exec "$1")"
  all="$(api GET '/api/executions?limit=1000')"
  if [[ -n "$root" ]]; then
    mapfile -t sessions < <(jq -r --argjson t "$(api GET "/api/executions/$root/tree")" '[.[] | select(.executionId as $i | $t | any(.executionId == $i)) | .sessionId] | unique[]' <<<"$all")
  else
    mapfile -t sessions < <(jq -r '[.[] | select(.status | test("RUNNING|PAUSED|QUEUED")) | .sessionId] | unique[]' <<<"$all")
  fi
  ((${#sessions[@]})) || return 0
  jq -r --arg root "$root" --argjson t "$([[ -n "$root" ]] && api GET "/api/executions/$root/tree" || echo '[]')" '
    ($t | map(.executionId)) as $ids
    | .[] | .executionId as $e | select($root == "" or ($ids | index($e) != null))
    | "\(.executionId[:8]) \(.nodeId) \(.name) since \(.since)"' <<<"$(pending "${sessions[@]}")"
}

# yk approve|reject EXEC [SIGNAL] [--data TEXT]: answers a node that waits for a signal
cmd_answer() {
  local verb="$1" exec signal="" data="" session found node name decision=approve
  shift
  exec="$(resolve_exec "${1:?usage: yk $verb <execution> [signal] [--data text]}")"
  shift
  [[ "$verb" == reject ]] && decision=reject
  while (($#)); do
    case "$1" in
      --data) data="${2:?--data needs text}"; shift 2 ;;
      -*) die "unknown option '$1'" ;;
      *) signal="$1"; shift ;;
    esac
  done
  session="$(session_of "$exec")"
  [[ -n "$session" ]] || die "execution $exec is not known to the server"
  # the node may wait in a run below this one (a sub-workflow): look through the whole tree
  found="$(pending "$session" | jq -c --argjson t "$(api GET "/api/executions/$exec/tree")" --arg s "$signal" '
    ($t | map(.executionId)) as $ids
    | [.[] | select(.executionId as $e | $ids | index($e)) | select($s == "" or .name == $s)]')"
  [[ "$(jq length <<<"$found")" == 1 ]] \
    || die "$(jq length <<<"$found") pending signals for $exec${signal:+ named $signal}; run: yk signals $exec"
  node="$(jq -r '.[0].nodeId' <<<"$found")"
  name="$(jq -r '.[0].name' <<<"$found")"
  exec="$(jq -r '.[0].executionId' <<<"$found")"
  api POST "/api/executions/$exec/nodes/$node/signal?name=$(uri "$name")&decision=$decision${data:+&data=$(uri "$data")}" >/dev/null
  echo "$decision: $exec $node ($name)"
}

# refresh_activity: writes "N running · M awaiting" to $DEV_HOME/activity for the status line
refresh_activity() {
  local all running sessions waiting=0 s
  all="$(api GET '/api/executions?limit=1000')" || return 0
  running="$(jq '[.[] | select(.status | test("RUNNING|PAUSED|QUEUED"))] | length' <<<"$all")"
  mapfile -t sessions < <(jq -r '[.[] | select(.status | test("RUNNING|PAUSED|QUEUED")) | .sessionId] | unique[]' <<<"$all")
  for s in "${sessions[@]}"; do waiting=$((waiting + $(api GET "/api/sessions/$s/approvals" | jq length))); done
  { ((running > 0)) && echo "$running running$( ((waiting > 0)) && echo " · $waiting awaiting")" || echo "idle"; } >"$DEV_HOME/activity.tmp"
  mv "$DEV_HOME/activity.tmp" "$DEV_HOME/activity"
}

# yk stats: from the heal events (the monitoring log every run appends to, see heal_events_file), one line per kind of run: runs, failed, median
# wall seconds and heal dollars; then, per stage and rung (the model that tried to fix it), attempts, fixes, fix rate and dollars. A run counts once per
# `result` event, so the numbers equal `jq 'select(.event=="result")' <events file>`. Without an events file it falls back to runs.tsv.
cmd_stats() {
  if [[ "${1:-}" == --decisions ]]; then
    need python3
    python3 -I "$here/scripts/decisions-report.py" "$STATE_DIR/decisions.tsv" "$here/decisions.json"
    return
  fi
  local ev; ev="$(heal_events_file)"
  if [[ -n "$ev" && -s "$ev" ]]; then
    stats_from_events "$ev"
    return 0
  fi
  local f="$STATE_DIR/runs.tsv"
  [[ -s "$f" ]] || { echo "no runs recorded yet ($ev, $f)"; return 0; }
  printf '%-14s %5s %8s %12s %10s %8s\n' kind runs failed median_bytes median_wall cost
  sort -t$'\t' -k2,2 "$f" | awk -F'\t' '
    function med(a, n,   i, j, t) { for (i = 2; i <= n; i++) { t = a[i]; for (j = i - 1; j >= 1 && a[j] + 0 > t + 0; j--) a[j + 1] = a[j]; a[j + 1] = t } return (n % 2) ? a[(n + 1) / 2] : (a[n / 2] + a[n / 2 + 1]) / 2 }
    function flush() { if (k == "") return; for (i = 1; i <= n; i++) { b[i] = B[i]; w[i] = W[i] }
      printf "%-14s %5d %8d %12d %10.1f %8.2f\n", k, n, bad, med(b, n), med(w, n), cost }
    $2 != k { flush(); k = $2; n = 0; bad = 0; cost = 0 }
    { n++; B[n] = $6; W[n] = $4; cost += $5; if ($3 != "SUCCESS") bad++ }
    END { flush() }'
}

stats_from_events() {
  printf '%-14s %5s %8s %11s %8s\n' kind runs failed median_wall cost
  jq -rs '
    def med: sort | if length == 0 then 0 elif length % 2 == 1 then .[(length - 1) / 2] else (.[length / 2 - 1] + .[length / 2]) / 2 end;
    ([.[] | select(.event == "fix")] | group_by(.run) | map({key: .[0].run, value: (map(.cost // 0) | add)}) | from_entries) as $cost
    | [.[] | select(.event == "result")] | group_by(.workflow) | sort_by(.[0].workflow)[]
    | [.[0].workflow, length, (map(select(.status != "SUCCESS")) | length), (map(.secs // 0) | med),
       (unique_by(.run) | map($cost[.run] // 0) | add)] | @tsv' "$1" |
    awk -F'\t' '{ printf "%-14s %5d %8d %11.1f %8.2f\n", $1, $2, $3, $4, $5 }'
  echo
  printf '%-14s %-8s %9s %6s %9s %8s\n' stage rung attempts fixed fix_rate cost
  jq -rs '
    [.[] | select(.event == "fix")] | group_by([.stage, (.model // "-")]) | sort_by(.[0].stage, .[0].model)[]
    | [.[0].stage, (.[0].model // "-"), length, (map(select(.fixed == true)) | length), (map(.cost // 0) | add)] | @tsv' "$1" |
    awk -F'\t' '{ printf "%-14s %-8s %9d %6d %8.0f%% %8.2f\n", $1, $2, $3, $4, ($3 ? 100 * $4 / $3 : 0), $5 }'
}

# yk detail SESSION EXECUTION [--grep P] [--tail N] [--head N]: the full output of the stage that failed the run (level 2), the line RESULT
# and MORE of a failed run name it. Without a filter all of it.
cmd_detail() {
  local session="${1:?usage: yk detail <session> <execution> [--grep P] [--tail N] [--head N]}" target="${2:?usage: yk detail <session> <execution> [--grep P] [--tail N] [--head N]}"
  shift 2
  local grep_p="" tail_n="" head_n=""
  while (($#)); do
    case "$1" in
      --grep) grep_p="${2:?--grep needs a pattern}"; shift 2 ;;
      --tail) tail_n="${2:?--tail needs a number}"; shift 2 ;;
      --head) head_n="${2:?--head needs a number}"; shift 2 ;;
      *) die "unknown option '$1' (yk detail <session> <execution> [--grep P] [--tail N] [--head N])" ;;
    esac
  done
  export YUKTA_SERVER_URL="${YUKTA_SERVER_URL:-$DEV_URL}"
  local text; text="$(failed_output "$session" "$target")"
  [[ -n "$text" ]] || { echo "no failed stage output for $target (it did not fail, or it is not a check or tool run)"; return 0; }
  [[ -z "$grep_p" ]] || text="$(grep -E -- "$grep_p" <<<"$text" || true)"
  [[ -z "$head_n" ]] || text="$(head -n "$head_n" <<<"$text")"
  [[ -z "$tail_n" ]] || text="$(tail -n "$tail_n" <<<"$text")"
  printf '%s\n' "$text"
}

# yk bench [--runs N] [--max-ratio R] [--check] [gradle args...]: the same Gradle work run directly and through yk, wall times (median of N, after
# one warm-up of each) and their ratio. Default task: :plugin-api:compileJava (up to date: start-up and loop overhead only). --check: all the
# Gradle tasks of the plan in one direct invocation against `yk check --no-heal`. Exit 1 when yk is slower than R times direct (default 1.5)
# and by more than 3 s, so a nightly job can fail on a regression of the loop itself.
cmd_bench() {
  local runs=3 max=1.5 check=0 args=() i d y t
  while (($#)); do
    case "$1" in
      --runs) runs="${2:?--runs needs a number}"; shift 2 ;;
      --max-ratio) max="${2:?--max-ratio needs a number}"; shift 2 ;;
      --check) check=1; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [[ "$runs" =~ ^[1-9][0-9]*$ ]] || die "--runs must be a positive number"
  local root; root="$(git rev-parse --show-toplevel)"
  local direct=() via=()
  if ((check)); then
    local tasks
    tasks="$("$here/scripts/plan.sh" | awk -F'\t' '$3 ~ /^\.\/gradlew / { print $3 }' | sed -E 's#^\./gradlew ##; s# -q --console=plain$##' | tr ' ' '\n' | grep -v '^-' | sort -u | paste -sd' ')"
    [[ -n "$tasks" ]] || die "yk bench --check: the plan has no Gradle stage (change something under a module)"
    direct=(bash -c "cd '$root' && ./gradlew --continue $tasks -q --console=plain")
    via=("${BASH_SOURCE[0]}" check --no-heal)
    echo "bench: yk check --no-heal against one direct Gradle run of: $tasks" >&2
  else
    ((${#args[@]})) || args=(:plugin-api:compileJava)
    direct=(bash -c "cd '$root' && ./gradlew $(printf '%q ' "${args[@]}")-q --console=plain")
    via=("${BASH_SOURCE[0]}" gradle "${args[@]}")
    echo "bench: yk gradle ${args[*]} against ./gradlew ${args[*]}" >&2
  fi
  elapsed() { awk -v a="$1" -v b="$(date +%s.%N)" 'BEGIN { printf "%.3f", b - a }'; }
  local dt=() yt=()
  "${direct[@]}" >/dev/null 2>&1 || true
  "${via[@]}" >/dev/null 2>&1 || true
  for ((i = 0; i < runs; i++)); do
    t="$(date +%s.%N)"; "${direct[@]}" >/dev/null 2>&1 || true; dt+=("$(elapsed "$t")")
    t="$(date +%s.%N)"; "${via[@]}" >/dev/null 2>&1 || true; yt+=("$(elapsed "$t")")
  done
  d="$(printf '%s\n' "${dt[@]}" | sort -n | awk '{ a[NR] = $1 } END { print a[int((NR + 1) / 2)] }')"
  y="$(printf '%s\n' "${yt[@]}" | sort -n | awk '{ a[NR] = $1 } END { print a[int((NR + 1) / 2)] }')"
  awk -v d="$d" -v y="$y" -v max="$max" -v n="$runs" 'BEGIN {
    r = (d > 0) ? y / d : 0
    printf "BENCH direct=%.2fs yk=%.2fs ratio=%.2f overhead=%.2fs runs=%d\n", d, y, r, y - d, n
    exit (r > max && y - d > 3) ? 1 : 0 }'
}

# yk statusline: one line for Claude Code's status line, from cached files only (no network)
cmd_statusline() {
  local label mark="✗" line status scope healed activity f
  if [[ -s "$DEV_HOME/server.pid" ]] && kill -0 "$(cat "$DEV_HOME/server.pid")" 2>/dev/null; then mark="✓"; fi
  label="$(server_env YUKTA_DEV_LABEL)"
  line="yukta :$DEV_PORT ${label:-down} $mark"
  f="$DEV_HOME/activity"
  [[ -s "$f" ]] && line+=" | $(<"$f")"
  if [[ ! -e "$f" || $(($(date +%s) - $(stat -c %Y "$f"))) -gt 10 ]]; then
    [[ "$mark" == "✓" ]] && (refresh_activity >/dev/null 2>&1 </dev/null &)
  fi
  f="$STATE_DIR/last-result"
  if [[ -s "$f" ]]; then
    IFS=$'\t' read -r _ status scope healed _ <"$f"
    line+=" | last: $scope $status"
    [[ "$healed" != - && -n "$healed" ]] && line+=" (healed $healed)"
  fi
  echo "$line"
}

# yk mcp-headers: the headers for Claude Code's MCP connection (.mcp.json headersHelper)
cmd_mcp_headers() { jq -n --arg k "$(dev_key)" '{"X-API-Key": $k}'; }

cmd="${1:-help}"
(($#)) && shift
case "$cmd" in
  up) cmd_up "$@" ;;
  down) cmd_down ;;
  status) rc=0; cmd_status || rc=$?; decision_probe || true; exit "$rc" ;;
  decision) cmd_decision ;;
  check) cmd_check "$@" ;;
  gradle) cmd_gradle "$@" ;;
  tool) cmd_tool "$@" ;;
  plan) exec "$here/scripts/plan.sh" "$@" ;;
  advise) exec "$here/scripts/advise.sh" "$@" ;;
  heal) need python3; exec python3 -I "$here/scripts/heal-report.py" "$@" ;;
  watch) cmd_watch "$@" ;;
  _notify) cmd_notify_run "$@" ;;
  tree) cmd_tree "$@" ;;
  pause | resume | stop) cmd_run_control "$cmd" "$@" ;;
  skip | unskip | retry) cmd_node_control "$cmd" "$@" ;;
  break) cmd_break "$@" ;;
  step) cmd_step "$@" ;;
  signals) cmd_signals "$@" ;;
  approve | reject) cmd_answer "$cmd" "$@" ;;
  stats) cmd_stats "$@" ;;
  detail) cmd_detail "$@" ;;
  statusline) cmd_statusline ;;
  bench) cmd_bench "$@" ;;
  mcp-headers) cmd_mcp_headers ;;
  sum) changes_sum "$REPO_ROOT" ;;
  result)
    export YUKTA_SERVER_URL="${YUKTA_SERVER_URL:-$DEV_URL}"
    print_result "${1:?usage: yk result <session> <execution>}" "${2:?usage: yk result <session> <execution>}" ;;
  cli) cmd_cli "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; die "unknown command '$cmd'" ;;
esac
