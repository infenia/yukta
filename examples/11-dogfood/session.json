{
  "sessionId": "example-11-dogfood",
  "name": "Dogfood: gradle check",
  "description": "Run the repo quality gates as a staged, fail-fast Yukta workflow.",
  "initiator": "examples",
  "projectPath": "__PROJECT_PATH__",
  "tags": {
    "example": "11-dogfood"
  },
  "workflows": {
    "gradle-check": {
      "workflowId": "gradle-check",
      "description": "gradle check, split into fail-fast stages",
      "nodes": [
        {
          "nodeId": "trigger",
          "type": "CONSTANT_SOURCE",
          "config": {}
        },
        {
          "nodeId": "spotless",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "spotlessCheck",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "compile",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "compileJava",
              "compileTestJava",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "tests",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "test",
              "jacocoTestReport",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "coverage",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "jacocoTestCoverageVerification",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "style",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "checkstyleMain",
              "checkstyleTest",
              "pmdMain",
              "pmdTest",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "spotbugs",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "spotbugsMain",
              "spotbugsTest",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "licenses",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "licensee",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "security",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "opengrep",
              "trivy",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "cli",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              ":cli:check",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "done",
          "type": "CONSOLE_TERMINAL",
          "config": {
            "displayOutput": true
          }
        }
      ],
      "edges": [
        {
          "source": "trigger",
          "target": "spotless"
        },
        {
          "source": "spotless",
          "target": "compile"
        },
        {
          "source": "compile",
          "target": "tests"
        },
        {
          "source": "tests",
          "target": "coverage"
        },
        {
          "source": "coverage",
          "target": "style"
        },
        {
          "source": "style",
          "target": "spotbugs"
        },
        {
          "source": "spotbugs",
          "target": "licenses"
        },
        {
          "source": "licenses",
          "target": "security"
        },
        {
          "source": "security",
          "target": "cli"
        },
        {
          "source": "cli",
          "target": "done"
        }
      ]
    },
    "quick-check": {
      "workflowId": "quick-check",
      "description": "Fast subset (formatting + Go vet) for a smoke test",
      "nodes": [
        {
          "nodeId": "trigger",
          "type": "CONSTANT_SOURCE",
          "config": {}
        },
        {
          "nodeId": "spotless",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "spotlessCheck",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 150,
            "failureMode": "ERROR",
            "timeoutSeconds": 150
          }
        },
        {
          "nodeId": "vet",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              ":cli:goVet",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeoutSeconds": 150,
            "timeout": 150,
            "failureMode": "ERROR"
          }
        },
        {
          "nodeId": "done",
          "type": "CONSOLE_TERMINAL",
          "config": {
            "displayOutput": true
          }
        }
      ],
      "edges": [
        {
          "source": "trigger",
          "target": "spotless"
        },
        {
          "source": "spotless",
          "target": "vet"
        },
        {
          "source": "vet",
          "target": "done"
        }
      ]
    },
    "gradle-run": {
      "workflowId": "gradle-run",
      "description": "Run arbitrary gradle args (any task, any module) as one fail-fast stage",
      "nodes": [
        {
          "nodeId": "trigger",
          "type": "CONSTANT_SOURCE",
          "config": {}
        },
        {
          "nodeId": "gradle",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "./gradlew",
              "__GRADLE_ARGS__",
              "-q",
              "--console=plain"
            ],
            "workingDir": "__PROJECT_PATH__",
            "timeout": 3600,
            "failureMode": "ERROR",
            "timeoutSeconds": 3600
          }
        },
        {
          "nodeId": "done",
          "type": "CONSOLE_TERMINAL",
          "config": {
            "displayOutput": true
          }
        }
      ],
      "edges": [
        {
          "source": "trigger",
          "target": "gradle"
        },
        {
          "source": "gradle",
          "target": "done"
        }
      ]
    }
  }
}
