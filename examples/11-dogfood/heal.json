{
  "models": [
    "haiku",
    "sonnet",
    "opus"
  ],
  "efforts": {
    "low": {
      "timeoutSeconds": 600,
      "budget": 0.5
    },
    "medium": {
      "timeoutSeconds": 1200,
      "budget": 1
    },
    "high": {
      "timeoutSeconds": 1800,
      "budget": 2
    }
  },
  "triage": {
    "model": "kev:4b-q4_K_M",
    "default": "average",
    "minProbability": 0.3,
    "levels": {
      "trivial": {
        "start": "haiku/low",
        "describe": "Formatting, an unused import, a typo: a mechanical fix"
      },
      "easy": {
        "start": "haiku/medium",
        "describe": "An obvious one-line compile or style error"
      },
      "simple": {
        "start": "haiku/high",
        "describe": "A compile or style error confined to one file"
      },
      "moderate": {
        "start": "sonnet/low",
        "describe": "A single straightforward failing assertion"
      },
      "average": {
        "start": "sonnet/medium",
        "describe": "A failing unit test or a typical analyzer finding"
      },
      "hard": {
        "start": "sonnet/high",
        "describe": "A logic bug across several classes"
      },
      "veryhard": {
        "start": "opus/low",
        "describe": "Concurrency or a design-level failure"
      }
    }
  },
  "analyzers": [
    "style",
    "spotbugs",
    "licenses",
    "security",
    "cli"
  ],
  "stages": {
    "spotless": {
      "auto": [
        "spotlessApply"
      ],
      "claude": true
    },
    "compile": {
      "claude": true
    },
    "tests": {
      "claude": true
    },
    "coverage": {
      "claude": true
    },
    "style": {
      "claude": true
    },
    "spotbugs": {
      "claude": true
    },
    "cli": {
      "claude": true
    },
    "ui": {
      "claude": true
    },
    "docs": {
      "claude": true
    },
    "reuse": {
      "claude": true
    },
    "actionlint": {
      "claude": true
    }
  },
  "extra": {
    "ui": {
      "modules": [
        "ui"
      ],
      "variants": [
        {
          "tool": "sh",
          "command": [
            "./gradlew",
            ":ui:pnpmLint",
            ":ui:pnpmTest",
            "-q",
            "--console=plain"
          ]
        }
      ]
    },
    "docs": {
      "modules": [
        "docs"
      ],
      "variants": [
        {
          "tool": "mint",
          "command": [
            "sh",
            "-c",
            "cd docs && mint broken-links"
          ]
        }
      ]
    },
    "reuse": {
      "variants": [
        {
          "tool": "reuse",
          "command": [
            "reuse",
            "lint"
          ]
        }
      ]
    },
    "actionlint": {
      "variants": [
        {
          "tool": "actionlint",
          "command": [
            "actionlint"
          ]
        },
        {
          "tool": "docker",
          "command": [
            "sh",
            "-c",
            "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667"
          ]
        }
      ]
    }
  }
}
