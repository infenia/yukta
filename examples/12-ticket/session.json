{
  "workflows": {
    "ticket": {
      "workflowId": "ticket",
      "description": "Turn a GitHub issue with acceptance criteria into a tested change on its own branch (walking skeleton).",
      "nodes": [
        {
          "nodeId": "trigger",
          "type": "CONSTANT_SOURCE",
          "config": {}
        },
        {
          "nodeId": "intake",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "intake",
              "${start.issue}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "intake.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the issue is not eligible (not open, assigned to you and Ready, or no acceptance criteria) or asks for something forbidden"
          }
        },
        {
          "nodeId": "init",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "init",
              "${start.issue}",
              "--run-id",
              "${start.runId}",
              "--root",
              "${start.project}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 300,
            "timeoutSeconds": 300,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "init.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "init failed or the issue is skipped (the branch or worktree exists)"
          }
        },
        {
          "nodeId": "claim",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "claim",
              "${start.issue}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "claim.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the issue could not be moved to In progress"
          }
        },
        {
          "nodeId": "route",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "route",
              "${start.run}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "route.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "route failed"
          }
        },
        {
          "nodeId": "route.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "route",
              "--reason",
              "route failed"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "architect",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "call",
              "architect",
              "${start.run}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 2400,
            "timeoutSeconds": 2400,
            "failureMode": "CONTINUE",
            "routeByExitCode": true,
            "outputFormat": "JSON",
            "engine": {
              "concurrencyGroup": "claude"
            }
          }
        },
        {
          "nodeId": "architect.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the architect failed, asked for clarification or stayed invalid"
          }
        },
        {
          "nodeId": "architect.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "architect",
              "--reason",
              "the architect failed, asked for clarification or stayed invalid"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "validate_spec",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "validate-spec",
              "${start.run}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 300,
            "timeoutSeconds": 300,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "validate_spec.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the spec is not valid (spec/validation.json)"
          }
        },
        {
          "nodeId": "validate_spec.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "validate_spec",
              "--reason",
              "the spec is not valid (spec/validation.json)"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "test_writer",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "call",
              "test_writer",
              "${start.run}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 2400,
            "timeoutSeconds": 2400,
            "failureMode": "CONTINUE",
            "routeByExitCode": true,
            "outputFormat": "JSON",
            "engine": {
              "concurrencyGroup": "claude"
            }
          }
        },
        {
          "nodeId": "test_writer.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the test writer failed"
          }
        },
        {
          "nodeId": "test_writer.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "test_writer",
              "--reason",
              "the test writer failed"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "gate_tests",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "gate-tests",
              "${start.run}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 3700,
            "timeoutSeconds": 3700,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "gate_tests.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the tests did not pass the red check"
          }
        },
        {
          "nodeId": "gate_tests.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "gate_tests",
              "--reason",
              "the tests did not pass the red check"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "preflight",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "flow",
              "preflight",
              "${start.run}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 60,
            "timeoutSeconds": 60,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "preflight.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the walking skeleton cannot run this spec (high risk or more than one step)"
          }
        },
        {
          "nodeId": "preflight.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "preflight",
              "--reason",
              "the walking skeleton cannot run this spec (high risk or more than one step)"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "plan_comment",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "plan-comment",
              "${start.run}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "plan_comment.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the plan could not be posted on the issue"
          }
        },
        {
          "nodeId": "plan_comment.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "plan_comment",
              "--reason",
              "the plan could not be posted on the issue"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "steps",
          "type": "SUB_WORKFLOW",
          "config": {
            "workflowId": "step",
            "timeoutSeconds": 7200,
            "routeByOutcome": true,
            "payload": {
              "project": "${start.project}",
              "run": "${start.run}",
              "worktree": "${start.worktree}",
              "claudeBin": "${start.claudeBin}",
              "gateStep": "${start.gateStep}",
              "gateFinal": "${start.gateFinal}",
              "stateDir": "${start.stateDir}",
              "step": "S1"
            }
          }
        },
        {
          "nodeId": "steps.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "a step failed (yk tree shows which)"
          }
        },
        {
          "nodeId": "steps.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "steps",
              "--reason",
              "a step failed (BLOCKED or it did not pass validation)"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "full_checks",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "flow",
              "full-checks",
              "${start.run}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 3700,
            "timeoutSeconds": 3700,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "full_checks.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the final gate failed"
          }
        },
        {
          "nodeId": "full_checks.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "full_checks",
              "--reason",
              "the final gate failed"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "review",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "call",
              "reviewer",
              "${start.run}",
              "--step",
              "S1",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 2400,
            "timeoutSeconds": 2400,
            "failureMode": "CONTINUE",
            "routeByExitCode": true,
            "outputFormat": "JSON",
            "engine": {
              "concurrencyGroup": "claude"
            }
          }
        },
        {
          "nodeId": "review.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the reviewer failed"
          }
        },
        {
          "nodeId": "review.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "review",
              "--reason",
              "the reviewer failed"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "verdict?",
          "type": "BRANCH",
          "config": {
            "mode": "SELECT_KEY",
            "selector": "payload['output']['verdict']",
            "cases": {
              "APPROVE": "approved"
            },
            "defaultPort": "changes"
          }
        },
        {
          "nodeId": "changes.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the reviewer requested changes"
          }
        },
        {
          "nodeId": "changes.dead",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "dead-end",
              "${start.run}",
              "--stage",
              "changes",
              "--reason",
              "the reviewer requested changes"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE"
          }
        },
        {
          "nodeId": "finish",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "github",
              "finish",
              "${start.run}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 600,
            "timeoutSeconds": 600,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "finish.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the draft PR could not be opened"
          }
        },
        {
          "nodeId": "close",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "flow",
              "close",
              "${start.run}",
              "--events",
              "${start.events}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 60,
            "timeoutSeconds": 60,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "done",
          "type": "CONSOLE_TERMINAL",
          "config": {
            "displayOutput": true
          }
        }
      ],
      "edges": [
        {
          "source": "trigger",
          "target": "intake"
        },
        {
          "source": "intake",
          "target": "init",
          "sourcePort": "success"
        },
        {
          "source": "intake",
          "target": "intake.failed",
          "sourcePort": "failure"
        },
        {
          "source": "init",
          "target": "claim",
          "sourcePort": "success"
        },
        {
          "source": "init",
          "target": "init.failed",
          "sourcePort": "failure"
        },
        {
          "source": "claim",
          "target": "route",
          "sourcePort": "success"
        },
        {
          "source": "claim",
          "target": "claim.failed",
