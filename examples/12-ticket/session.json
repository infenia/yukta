    "step": {
      "workflowId": "step",
      "description": "One step of a ticket: base commit and packet, the implementer, validation, commit.",
      "nodes": [
        {
          "nodeId": "trigger",
          "type": "CONSTANT_SOURCE",
          "config": {}
        },
        {
          "nodeId": "begin",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "flow",
              "step-begin",
              "${start.run}",
              "${start.step}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 300,
            "timeoutSeconds": 300,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "begin.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the step base or packet failed"
          }
        },
        {
          "nodeId": "implement",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "call",
              "implementer",
              "${start.run}",
              "--step",
              "${start.step}",
              "--attempt",
              "1",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 2400,
            "timeoutSeconds": 2400,
            "failureMode": "CONTINUE",
            "routeByExitCode": true,
            "outputFormat": "JSON",
            "engine": {
              "concurrencyGroup": "claude"
            }
          }
        },
        {
          "nodeId": "implement.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the implementer failed or its answer stayed invalid after one retry"
          }
        },
        {
          "nodeId": "result?",
          "type": "BRANCH",
          "config": {
            "mode": "SELECT_KEY",
            "selector": "payload['output']['status']",
            "cases": {
              "DONE": "done"
            },
            "defaultPort": "blocked"
          }
        },
        {
          "nodeId": "blocked",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "BLOCKED: the implementer reported it cannot do the step"
          }
        },
        {
          "nodeId": "validate",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "flow",
              "validate-step",
              "${start.run}",
              "${start.step}",
              "--attempt",
              "1",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 3700,
            "timeoutSeconds": 3700,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "validate.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the step did not pass validation (failure.json)"
          }
        },
        {
          "nodeId": "commit",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": [
              "__TICKET__/ticketkit",
              "flow",
              "commit-step",
              "${start.run}",
              "${start.step}",
              "--worktree",
              "${start.worktree}"
            ],
            "workingDir": "${start.project}",
            "env": {
              "YK_CLAUDE_BIN": "${start.claudeBin}",
              "TICKET_GATE_STEP": "${start.gateStep}",
              "TICKET_GATE_FINAL": "${start.gateFinal}",
              "YUKTA_DEV_STATE_DIR": "${start.stateDir}"
            },
            "timeout": 120,
            "timeoutSeconds": 120,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        {
          "nodeId": "commit.failed",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "the step could not be committed"
          }
        },
        {
          "nodeId": "ok",
          "type": "CONSOLE_TERMINAL",
          "config": {}
        }
      ],
      "edges": [
        {
          "source": "trigger",
          "target": "begin"
        },
        {
          "source": "begin",
          "target": "implement",
          "sourcePort": "success"
