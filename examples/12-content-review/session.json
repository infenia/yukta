{
  "sessionId": "example-12-content-review",
  "name": "Content review",
  "description": "A draft goes through automatic rule checks, then an editor approves it or asks for changes. Changes loop back for at most 3 rounds; approved pieces are published and the team is notified.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": {
    "example": "12-content-review"
  },
  "workflows": {
    "round": {
      "workflowId": "round",
      "description": "One review round: draft, rule check, editor decision. Ends with outcome SUCCESS (approved) or RETRY (changes wanted).",
      "nodes": [
        {
          "nodeId": "trigger",
          "type": "API_TRIGGER",
          "config": {}
        },
        {
          "nodeId": "draft",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "title": "payload.title",
              "maxWords": "payload.maxWords",
              "attempt": "payload.attempt",
              "notes": "payload.notes",
              "draft": "payload.attempt == 1 ? payload.pitch : 'A plain, factual description of ' + payload.title + ' (revision ' + payload.attempt + ')'",
              "pitch": "payload.pitch",
              "slug": "payload.slug"
            }
          }
        },
        {
          "nodeId": "check",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "words": "payload.draft.split(' ').length",
              "problems": "({'guaranteed', 'miracle', 'risk-free'}.?[#root.payload.draft.toLowerCase().contains(#this)].isEmpty() ? '' : 'banned words: ' + {'guaranteed', 'miracle', 'risk-free'}.?[#root.payload.draft.toLowerCase().contains(#this)].toString()) + (payload.draft.split(' ').length > payload.maxWords ? ' too long: ' + payload.draft.split(' ').length + ' words, limit ' + payload.maxWords : '')"
            }
          }
        },
        {
          "nodeId": "gate",
          "type": "BRANCH",
          "config": {
            "mode": "EXPRESSION",
            "cases": {
              "payload.problems == ''": "clean",
              "payload.problems != ''": "fix"
            },
            "strictMode": true
          }
        },
        {
          "nodeId": "auto-notes",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "title": "payload.title",
              "maxWords": "payload.maxWords",
              "attempt": "payload.attempt",
              "notes": "'automatic check failed: ' + payload.problems",
              "pitch": "payload.pitch",
              "slug": "payload.slug"
            }
          }
        },
        {
          "nodeId": "editor",
          "type": "WAIT_FOR_SIGNAL",
          "config": {
            "signal": "review",
            "timeoutSeconds": 900,
            "onTimeout": "FAIL",
            "onReject": "FAIL"
          }
        },
        {
          "nodeId": "decide",
          "type": "BRANCH",
          "config": {
            "mode": "EXPRESSION",
            "cases": {
              "metadata['signal.decision'] == 'approve'": "approved",
              "metadata['signal.decision'] != 'approve'": "changes"
            },
            "strictMode": true
          }
        },
        {
          "nodeId": "approved-payload",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "title": "payload.title",
              "draft": "payload.draft",
              "attempt": "payload.attempt",
              "slug": "payload.slug"
            }
          }
        },
        {
          "nodeId": "changes-payload",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "title": "payload.title",
              "maxWords": "payload.maxWords",
              "attempt": "payload.attempt",
              "notes": "metadata['signal.data']",
              "pitch": "payload.pitch",
              "slug": "payload.slug"
            }
          }
        },
        {
          "nodeId": "approved",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "SUCCESS",
            "reason": "approved by the editor"
          }
        },
        {
          "nodeId": "revise",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "RETRY",
            "reason": "changes wanted"
          }
        }
      ],
      "edges": [
        {
          "source": "trigger",
          "target": "draft"
        },
        {
          "source": "draft",
          "target": "check"
        },
        {
          "source": "check",
          "target": "gate"
        },
        {
          "source": "gate",
          "target": "editor",
          "sourcePort": "clean"
        },
        {
          "source": "gate",
          "target": "auto-notes",
          "sourcePort": "fix"
        },
        {
          "source": "auto-notes",
          "target": "revise"
        },
        {
          "source": "editor",
          "target": "decide"
        },
        {
          "source": "decide",
          "target": "approved-payload",
          "sourcePort": "approved"
        },
        {
          "source": "decide",
          "target": "changes-payload",
          "sourcePort": "changes"
        },
        {
          "source": "approved-payload",
          "target": "approved"
        },
        {
          "source": "changes-payload",
          "target": "revise"
        }
      ]
    },
    "review": {
      "workflowId": "review",
      "description": "Validate the brief, run up to 3 review rounds, publish when approved, notify the team either way",
      "nodes": [
        {
          "nodeId": "trigger",
          "type": "API_TRIGGER",
          "config": {}
        },
        {
          "nodeId": "validate",
          "type": "VALIDATE",
          "config": {
            "required": [
              "title",
              "slug",
              "pitch"
            ],
            "types": {
              "title": "string",
              "slug": "string",
              "pitch": "string",
              "maxWords": "number"
            }
          }
        },
        {
          "nodeId": "bad-brief",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "path": "'outbox.log'",
              "content": "'NOT PUBLISHED: the brief is invalid'"
            }
          }
        },
        {
          "nodeId": "start-round-1",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "title": "payload.title",
              "pitch": "payload.pitch",
              "maxWords": "payload['maxWords'] != null ? payload['maxWords'] : 60",
              "attempt": "1",
              "notes": "''",
              "slug": "payload.slug"
            }
          }
        },
        {
          "nodeId": "round-1",
          "type": "SUB_WORKFLOW",
          "config": {
            "workflowId": "round",
            "routeByOutcome": true,
            "timeoutSeconds": 1000
          }
        },
        {
          "nodeId": "start-round-2",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "title": "payload.results[0].title",
              "pitch": "payload.results[0].pitch",
              "maxWords": "payload.results[0].maxWords",
              "attempt": "payload.results[0].attempt + 1",
              "notes": "payload.results[0].notes",
              "slug": "payload.results[0].slug"
            }
          }
        },
        {
          "nodeId": "round-2",
          "type": "SUB_WORKFLOW",
          "config": {
            "workflowId": "round",
            "routeByOutcome": true,
            "timeoutSeconds": 1000
          }
        },
        {
          "nodeId": "start-round-3",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "title": "payload.results[0].title",
              "pitch": "payload.results[0].pitch",
              "maxWords": "payload.results[0].maxWords",
              "attempt": "payload.results[0].attempt + 1",
              "notes": "payload.results[0].notes",
              "slug": "payload.results[0].slug"
            }
          }
        },
        {
          "nodeId": "round-3",
          "type": "SUB_WORKFLOW",
          "config": {
            "workflowId": "round",
            "routeByOutcome": true,
            "timeoutSeconds": 1000
          }
        },
        {
          "nodeId": "stamp-published",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "path": "payload.results[0].slug + '.md'",
              "title": "payload.results[0].title",
              "content": "'# ' + payload.results[0].title + '\\n\\n' + payload.results[0].draft + '\\n'"
            }
          }
        },
        {
          "nodeId": "publish",
          "type": "FILE_WRITE",
          "config": {
            "baseDir": "/tmp/yukta-examples/content-review/site",
            "contentField": "content"
          }
        },
        {
          "nodeId": "stamp-notify-ok",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "path": "'outbox.log'",
              "content": "'PUBLISHED: ' + payload.title + ' -> ' + payload.path"
            }
          }
        },
        {
          "nodeId": "notify-ok",
          "type": "FILE_WRITE",
          "config": {
            "baseDir": "/tmp/yukta-examples/content-review",
            "contentField": "content",
            "append": true
          }
        },
        {
          "nodeId": "done",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "SUCCESS",
            "reason": "published"
          }
        },
        {
          "nodeId": "stamp-notify-stop",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "path": "'outbox.log'",
              "content": "payload['outcome'] == 'RETRY' ? 'NOT PUBLISHED: not approved after 3 rounds, needs a human writer' : 'NOT PUBLISHED: the editor rejected the piece'"
            }
          }
        },
        {
          "nodeId": "notify-stop",
          "type": "FILE_WRITE",
          "config": {
            "baseDir": "/tmp/yukta-examples/content-review",
            "contentField": "content",
            "append": true
          }
        },
        {
          "nodeId": "stopped",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "not published"
          }
        }
      ],
      "edges": [
        {
          "source": "trigger",
          "target": "validate"
        },
        {
          "source": "validate",
          "target": "start-round-1"
        },
        {
          "source": "validate",
          "target": "bad-brief",
          "sourcePort": "invalid"
        },
        {
          "source": "bad-brief",
          "target": "notify-stop"
        },
        {
          "source": "start-round-1",
          "target": "round-1"
        },
        {
          "source": "round-1",
          "target": "stamp-published",
          "sourcePort": "success"
        },
        {
          "source": "round-1",
          "target": "start-round-2",
          "sourcePort": "retry"
        },
        {
          "source": "round-1",
          "target": "stamp-notify-stop",
          "sourcePort": "failure"
        },
        {
          "source": "start-round-2",
          "target": "round-2"
        },
        {
          "source": "round-2",
          "target": "stamp-published",
          "sourcePort": "success"
        },
        {
          "source": "round-2",
          "target": "start-round-3",
          "sourcePort": "retry"
        },
        {
          "source": "round-2",
          "target": "stamp-notify-stop",
          "sourcePort": "failure"
        },
        {
          "source": "start-round-3",
          "target": "round-3"
        },
        {
          "source": "round-3",
          "target": "stamp-published",
          "sourcePort": "success"
        },
        {
          "source": "round-3",
          "target": "stamp-notify-stop",
          "sourcePort": "retry"
        },
        {
          "source": "round-3",
          "target": "stamp-notify-stop",
          "sourcePort": "failure"
        },
        {
          "source": "stamp-published",
          "target": "publish"
        },
        {
          "source": "publish",
          "target": "stamp-notify-ok"
        },
        {
          "source": "stamp-notify-ok",
          "target": "notify-ok"
        },
        {
          "source": "notify-ok",
          "target": "done"
        },
        {
          "source": "stamp-notify-stop",
          "target": "notify-stop"
        },
        {
          "source": "notify-stop",
          "target": "stopped"
        }
      ]
    }
  }
}
