{
  "sessionId": "example-04-loan-approval",
  "name": "Loan approval",
  "description": "Score a loan application with fixed rules: auto-approve clear cases, auto-decline clear rejects, send borderline cases to an underwriter, and strip sensitive fields before notifying.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": {
    "example": "04-loan-approval"
  },
  "workflows": {
    "loan": {
      "workflowId": "loan",
      "description": "Validate, score, route (approve / decline / human review), redact, notify",
      "nodes": [
        {
          "nodeId": "application",
          "type": "API_TRIGGER",
          "config": {}
        },
        {
          "nodeId": "validate",
          "type": "VALIDATE",
          "config": {
            "required": [
              "applicationId",
              "email",
              "ssn",
              "income",
              "loanAmount",
              "creditScore",
              "monthlyDebt"
            ],
            "types": {
              "applicationId": "string",
              "email": "string",
              "income": "number",
              "loanAmount": "number",
              "creditScore": "number",
              "monthlyDebt": "number"
            }
          }
        },
        {
          "nodeId": "mark-invalid",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": {
              "applicationId": "payload.applicationId",
              "email": "payload.email",
              "ssn": "payload.ssn",
              "decision": "'NEEDS_INFO'",
              "decidedBy": "'validator'",
              "reason": "'application is incomplete or has wrong field types'"
            }
          }
        },
        {
          "nodeId": "score",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "score": "(payload.creditScore >= 750 ? 40 : (payload.creditScore >= 680 ? 30 : (payload.creditScore >= 620 ? 15 : 0))) + (payload.loanAmount <= payload.income * 0.5 ? 30 : (payload.loanAmount <= payload.income ? 15 : 0)) + (payload.monthlyDebt * 12 <= payload.income * 0.2 ? 30 : (payload.monthlyDebt * 12 <= payload.income * 0.4 ? 15 : 0))"
            }
          }
        },
        {
          "nodeId": "route",
          "type": "BRANCH",
          "config": {
            "mode": "EXPRESSION",
            "cases": {
              "payload.creditScore < 500 || payload.score < 40": "decline",
              "payload.score >= 75": "approve",
              "payload.score >= 40 && payload.score < 75": "review"
            },
            "strictMode": true
          }
        },
        {
          "nodeId": "auto-approve",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "decision": "'APPROVED'",
              "decidedBy": "'rules'",
              "reason": "'score ' + payload.score + ' is at or above 75'"
            }
          }
        },
        {
          "nodeId": "auto-decline",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "decision": "'DECLINED'",
              "decidedBy": "'rules'",
              "reason": "'score ' + payload.score + ' is below 40, or credit score is below 500'"
            }
          }
        },
        {
          "nodeId": "underwriter",
          "type": "WAIT_FOR_SIGNAL",
          "config": {
            "signal": "underwriter",
            "timeoutSeconds": 86400,
            "onTimeout": "CONTINUE",
            "onReject": "FAIL",
            "engine": {
              "onError": "ROUTE"
            }
          }
        },
        {
          "nodeId": "after-review",
          "type": "BRANCH",
          "config": {
            "mode": "EXPRESSION",
            "cases": {
              "metadata['signal.decision'] == 'timeout'": "timed-out",
              "metadata['signal.decision'] == 'decline'": "declined",
              "metadata['signal.decision'] != 'timeout' && metadata['signal.decision'] != 'decline'": "approved"
            },
            "strictMode": true
          }
        },
        {
          "nodeId": "human-approve",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "decision": "'APPROVED'",
              "decidedBy": "'underwriter'",
              "reason": "'borderline score ' + payload.score + ', approved by an underwriter'"
            }
          }
        },
        {
          "nodeId": "human-decline",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "decision": "'DECLINED'",
              "decidedBy": "'underwriter'",
              "reason": "'borderline score ' + payload.score + ', declined by an underwriter'"
            }
          }
        },
        {
          "nodeId": "review-timeout",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "decision": "'ESCALATED'",
              "decidedBy": "'timeout'",
              "reason": "'no underwriter answer in time, escalate to the credit manager'"
            }
          }
        },
        {
          "nodeId": "redact",
          "type": "CONTENT_FILTER",
          "config": {
            "mode": "EXCLUDE",
            "paths": [
              "ssn",
              "income",
              "creditScore",
              "monthlyDebt",
              "loanAmount"
            ]
          }
        },
        {
          "nodeId": "compose",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "text": "'Application ' + payload.applicationId + ': ' + payload.decision + ' by ' + payload.decidedBy + ' (' + payload.reason + ')'"
            }
          }
        },
        {
          "nodeId": "notify",
          "type": "FILE_WRITE",
          "config": {
            "baseDir": "/tmp/yukta-example-loan-approval",
            "path": "outbox.log",
            "contentField": "text",
            "append": true
          }
        },
        {
          "nodeId": "end",
          "type": "CONSOLE_TERMINAL",
          "config": {}
        },
        {
          "nodeId": "rejected-stop",
          "type": "OUTCOME_TERMINAL",
          "config": {
            "outcome": "FAILED",
            "reason": "underwriter rejected the application: pulled from the automated flow, nothing sent"
          }
        }
      ],
      "edges": [
        {
          "source": "application",
          "target": "validate"
        },
        {
          "source": "validate",
          "target": "score"
        },
        {
          "source": "validate",
          "target": "mark-invalid",
          "sourcePort": "invalid"
        },
        {
          "source": "score",
          "target": "route"
        },
        {
          "source": "route",
          "target": "auto-approve",
          "sourcePort": "approve"
        },
        {
          "source": "route",
          "target": "auto-decline",
          "sourcePort": "decline"
        },
        {
          "source": "route",
          "target": "underwriter",
          "sourcePort": "review"
        },
        {
          "source": "underwriter",
          "target": "after-review"
        },
        {
          "source": "underwriter",
          "target": "rejected-stop",
          "sourcePort": "error"
        },
        {
          "source": "after-review",
          "target": "human-approve",
          "sourcePort": "approved"
        },
        {
          "source": "after-review",
          "target": "review-timeout",
          "sourcePort": "timed-out"
        },
        {
          "source": "mark-invalid",
          "target": "redact"
        },
        {
          "source": "auto-approve",
          "target": "redact"
        },
        {
          "source": "auto-decline",
          "target": "redact"
        },
        {
          "source": "human-approve",
          "target": "redact"
        },
        {
          "source": "review-timeout",
          "target": "redact"
        },
        {
          "source": "redact",
          "target": "compose"
        },
        {
          "source": "compose",
          "target": "notify"
        },
        {
          "source": "notify",
          "target": "end"
        },
        {
          "source": "after-review",
          "target": "human-decline",
          "sourcePort": "declined"
        },
        {
          "source": "human-decline",
          "target": "redact"
        }
      ]
    }
  }
}
