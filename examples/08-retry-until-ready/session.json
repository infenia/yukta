{
  "sessionId": "example-08-retry-until-ready",
  "name": "Retry until ready",
  "description": "Repeat a check until its exit condition holds, with a bounded number of attempts.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": { "example": "08-retry-until-ready" },
  "workflows": {
    "wait-ready": {
      "workflowId": "wait-ready",
      "description": "Repeat a check up to 5 times, 1s apart, stopping after 3 attempts",
      "nodes": [
        { "nodeId": "start", "type": "ONE_SHOT", "config": {} },
        {
          "nodeId": "poll",
          "type": "LOOP_PREDICATE",
          "config": {
            "targetPluginId": "PROCESS_EXECUTOR",
            "targetConfig": { "command": ["echo", "checking readiness"], "failureMode": "CONTINUE" },
            "exitCondition": "#iterationCount >= 3",
            "maxIterations": 5,
            "maxDuration": "PT1M",
            "delayInterval": "PT1S",
            "failureStrategy": "ABORT"
          }
        },
        { "nodeId": "end", "type": "CONSOLE_TERMINAL", "config": {} }
      ],
      "edges": [
        { "source": "start", "target": "poll" },
        { "source": "poll", "target": "end" }
      ]
    }
  }
}
