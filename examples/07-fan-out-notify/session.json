{
  "sessionId": "example-07-fan-out",
  "name": "Fan-out notify",
  "description": "One event is delivered to several channels in parallel.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": { "example": "07-fan-out-notify" },
  "workflows": {
    "notify": {
      "workflowId": "notify",
      "description": "Send the same event to slack, email and pager",
      "nodes": [
        { "nodeId": "start", "type": "ONE_SHOT", "config": {} },
        { "nodeId": "fan-out", "type": "RECIPIENT_LIST", "config": { "mode": "STATIC", "recipients": ["slack", "email", "pager"], "parallel": true } },
        { "nodeId": "slack", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "notified: slack"] } },
        { "nodeId": "email", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "notified: email"] } },
        { "nodeId": "pager", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "notified: pager"] } },
        { "nodeId": "end", "type": "CONSOLE_TERMINAL", "config": {} }
      ],
      "edges": [
        { "source": "start", "target": "fan-out" },
        { "source": "fan-out", "target": "slack", "sourcePort": "slack" },
        { "source": "fan-out", "target": "email", "sourcePort": "email" },
        { "source": "fan-out", "target": "pager", "sourcePort": "pager" },
        { "source": "slack", "target": "end" },
        { "source": "email", "target": "end" },
        { "source": "pager", "target": "end" }
      ]
    }
  }
}
