{
  "sessionId": "example-04-quality-gate",
  "name": "Quality gate",
  "description": "Decide pass or fail from metrics sent in the request payload (for example by an AI agent after a change).",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": { "example": "04-quality-gate" },
  "workflows": {
    "gate": {
      "workflowId": "gate",
      "description": "Route to pass or fail based on coverage and lint errors",
      "nodes": [
        { "nodeId": "trigger", "type": "api-trigger", "config": {} },
        {
          "nodeId": "decide",
          "type": "BRANCH",
          "config": {
            "mode": "EXPRESSION",
            "cases": {
              "payload.coverage >= 80 && payload.lintErrors == 0": "pass",
              "payload.coverage < 80 || payload.lintErrors > 0": "fail"
            },
            "allowMultipleMatches": false,
            "strictMode": true
          }
        },
        { "nodeId": "report-pass", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "QUALITY GATE PASSED"] } },
        { "nodeId": "report-fail", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "QUALITY GATE FAILED"] } },
        { "nodeId": "end", "type": "CONSOLE_TERMINAL", "config": {} }
      ],
      "edges": [
        { "source": "trigger", "target": "decide" },
        { "source": "decide", "target": "report-pass", "sourcePort": "pass" },
        { "source": "decide", "target": "report-fail", "sourcePort": "fail" },
        { "source": "report-pass", "target": "end" },
        { "source": "report-fail", "target": "end" }
      ]
    }
  }
}
