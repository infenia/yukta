{
  "id": "example-03-release-guard",
  "type": "rules",
  "dryRun": false,
  "settings": {
    "rules": [
      {
        "id": "no-kill-during-release",
        "deny": {
          "command": "StopWorkflow",
          "if": "mode == 'KILL'",
          "reason": "use DRAIN or CANCEL on a release: KILL can leave production half deployed"
        }
      }
    ]
  }
}
