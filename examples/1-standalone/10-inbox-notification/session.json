{
  "sessionId": "example-10-inbox",
  "name": "Inbox notification",
  "description": "A workflow raises a notification in the Yukta inbox with a NOTIFY_TERMINAL.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": { "example": "10-inbox-notification" },
  "workflows": {
    "report": {
      "workflowId": "report",
      "description": "Run a command and tell the operators in the inbox",
      "nodes": [
        { "nodeId": "start", "type": "CONSTANT_SOURCE", "color": "sky", "config": {} },
        { "nodeId": "check", "type": "PROCESS_EXECUTOR", "color": "teal", "config": { "command": ["echo", "nightly report ready"] } },
        {
          "nodeId": "tell",
          "type": "NOTIFY_TERMINAL",
          "color": "stone",
          "config": {
            "target": "inbox",
            "title": "Nightly report ready",
            "severity": "INFO",
            "audience": ["role:OPERATOR"],
            "text": "The nightly report finished."
          }
        }
      ],
      "edges": [
        { "source": "start", "target": "check" },
        { "source": "check", "target": "tell" }
      ]
    }
  }
}
