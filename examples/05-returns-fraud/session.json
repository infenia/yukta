{
  "sessionId": "example-05-returns-fraud",
  "name": "Returns and refund fraud screen",
  "description": "Score a return request with fixed risk rules, refund low-risk returns automatically, queue risky ones for a human reviewer, and tell the customer without leaking internal fields.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": { "example": "05-returns-fraud" },
  "workflows": {
    "returns": {
      "workflowId": "returns",
      "description": "Validate, score fraud risk, auto-refund or review, refund, notify",
      "nodes": [
        { "nodeId": "return-request", "type": "API_TRIGGER", "config": {} },
        {
          "nodeId": "validate",
          "type": "VALIDATE",
          "config": {
            "required": ["returnId", "orderId", "customerEmail", "amount", "reason", "ordersLast365d", "returnsLast365d", "accountAgeDays"],
            "types": { "returnId": "string", "orderId": "string", "customerEmail": "string", "amount": "number", "reason": "string", "ordersLast365d": "number", "returnsLast365d": "number", "accountAgeDays": "number" }
          }
        },
        {
          "nodeId": "mark-invalid",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "mapping": { "returnId": "payload.returnId", "customerEmail": "payload.customerEmail", "decision": "'NEEDS_INFO'", "note": "'We could not read your return request. Please resubmit it.'" }
          }
        },
        {
          "nodeId": "risk",
          "type": "MAPPER",
          "config": {
            "mode": "PROJECTION",
            "dropOriginal": false,
            "mapping": {
              "riskScore": "(payload.amount > 500 ? 35 : (payload.amount > 200 ? 20 : 0)) + (payload.returnsLast365d * 2 > payload.ordersLast365d ? 40 : (payload.returnsLast365d * 10 > payload.ordersLast365d * 3 ? 20 : 0)) + (payload.accountAgeDays < 30 ? 25 : 0) + (payload.reason == 'not_received' ? 15 : 0)"
            }
          }
        },
        {
          "nodeId": "route",
          "type": "BRANCH",
          "config": {
            "mode": "EXPRESSION",
            "cases": {
              "payload.riskScore < 30": "low",
              "payload.riskScore >= 30": "high"
            },
            "strictMode": true
          }
        },
        {
          "nodeId": "auto-approve",
          "type": "MAPPER",
          "config": { "mode": "PROJECTION", "dropOriginal": false, "mapping": { "decision": "'REFUND_APPROVED'", "decidedBy": "'rules'", "note": "'Your refund of ' + payload.amount + ' is on its way.'" } }
        },
        {
          "nodeId": "review-queue",
          "type": "WAIT_FOR_SIGNAL",
          "config": {
            "signal": "review",
            "timeoutSeconds": 86400,
            "onTimeout": "CONTINUE",
            "onReject": "FAIL",
            "engine": { "onError": "ROUTE" }
          }
        },
        {
          "nodeId": "after-review",
          "type": "BRANCH",
          "config": {
            "mode": "EXPRESSION",
            "cases": {
              "metadata['signal.decision'] == 'timeout'": "timed-out",
              "metadata['signal.decision'] == 'deny'": "denied",
              "metadata['signal.decision'] != 'timeout' && metadata['signal.decision'] != 'deny'": "approved"
            },
            "strictMode": true
          }
        },
        {
          "nodeId": "reviewer-approve",
          "type": "MAPPER",
          "config": { "mode": "PROJECTION", "dropOriginal": false, "mapping": { "decision": "'REFUND_APPROVED'", "decidedBy": "'reviewer'", "note": "'After a check, your refund of ' + payload.amount + ' is on its way.'" } }
        },
        {
          "nodeId": "reviewer-deny",
          "type": "MAPPER",
          "config": { "mode": "PROJECTION", "dropOriginal": false, "mapping": { "decision": "'REFUND_DENIED'", "decidedBy": "'reviewer'", "note": "'We could not approve this return. Reply to this message to appeal.'" } }
        },
        {
          "nodeId": "review-timeout",
          "type": "MAPPER",
          "config": { "mode": "PROJECTION", "dropOriginal": false, "mapping": { "decision": "'STILL_IN_REVIEW'", "decidedBy": "'timeout'", "note": "'Your return needs a little longer. We will write again within 2 days.'" } }
        },
        {
          "nodeId": "fraud-escalation",
          "type": "OUTCOME_TERMINAL",
          "config": { "outcome": "ESCALATE", "reason": "reviewer rejected the case: handed to the fraud team, no customer message sent" }
        },
        {
          "nodeId": "refund-line",
          "type": "MAPPER",
          "config": { "mode": "PROJECTION", "dropOriginal": false, "mapping": { "refundLine": "'REFUND ' + payload.returnId + ' order=' + payload.orderId + ' amount=' + payload.amount + ' card=****' + payload.cardLast4 + ' by=' + payload.decidedBy" } }
        },
        {
          "nodeId": "refund",
          "type": "FILE_WRITE",
          "config": { "baseDir": "/tmp/yukta-example-returns-fraud", "path": "refunds.log", "contentField": "refundLine", "append": true }
        },
        {
          "nodeId": "redact",
          "type": "CONTENT_FILTER",
          "config": { "mode": "EXCLUDE", "paths": ["cardLast4", "riskScore", "decidedBy", "refundLine", "returnsLast365d", "ordersLast365d", "accountAgeDays"] }
        },
        {
          "nodeId": "compose",
          "type": "MAPPER",
          "config": { "mode": "PROJECTION", "dropOriginal": false, "mapping": { "text": "'To ' + payload.customerEmail + ' | return ' + payload.returnId + ' | ' + payload.decision + ' | ' + payload.note" } }
        },
        {
          "nodeId": "notify-customer",
          "type": "FILE_WRITE",
          "config": { "baseDir": "/tmp/yukta-example-returns-fraud", "path": "outbox.log", "contentField": "text", "append": true }
        },
        { "nodeId": "end", "type": "CONSOLE_TERMINAL", "config": {} }
      ],
      "edges": [
        { "source": "return-request", "target": "validate" },
        { "source": "validate", "target": "risk" },
        { "source": "validate", "target": "mark-invalid", "sourcePort": "invalid" },
        { "source": "risk", "target": "route" },
        { "source": "route", "target": "auto-approve", "sourcePort": "low" },
        { "source": "route", "target": "review-queue", "sourcePort": "high" },
        { "source": "review-queue", "target": "after-review" },
        { "source": "review-queue", "target": "fraud-escalation", "sourcePort": "error" },
        { "source": "after-review", "target": "reviewer-approve", "sourcePort": "approved" },
        { "source": "after-review", "target": "reviewer-deny", "sourcePort": "denied" },
        { "source": "after-review", "target": "review-timeout", "sourcePort": "timed-out" },
        { "source": "auto-approve", "target": "refund-line" },
        { "source": "reviewer-approve", "target": "refund-line" },
        { "source": "refund-line", "target": "refund" },
        { "source": "refund", "target": "redact" },
        { "source": "mark-invalid", "target": "redact" },
        { "source": "reviewer-deny", "target": "redact" },
        { "source": "review-timeout", "target": "redact" },
        { "source": "redact", "target": "compose" },
        { "source": "compose", "target": "notify-customer" },
        { "source": "notify-customer", "target": "end" }
      ]
    }
  }
}
