{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestWriterResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["test_files", "notes", "blocked"],
  "properties": {
    "test_files": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "test_file",
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "cases"],
        "properties": {
          "path": {
            "type": "string"
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[0-9]+$"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 200
    },
    "blocked": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "detail"],
          "properties": {
            "category": {
              "enum": ["case_ambiguous", "stub_missing", "framework_unclear"]
            },
            "detail": {
              "type": "string",
              "maxLength": 300
            },
            "question": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      ]
    }
  },
  "$id": "test-writer-result.schema.json"
}
