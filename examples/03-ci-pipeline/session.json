{
  "sessionId": "example-03-ci-pipeline",
  "name": "CI pipeline gate",
  "description": "Run a check command and route to a pass or fail report based on its exit code.",
  "initiator": "examples",
  "projectPath": "/tmp",
  "tags": { "example": "03-ci-pipeline" },
  "workflows": {
    "ci-pass": {
      "workflowId": "ci-pass",
      "description": "Checks succeed: the success port is taken",
      "nodes": [
        { "nodeId": "start", "type": "ONE_SHOT", "config": {} },
        {
          "nodeId": "tests",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": ["sh", "-c", "echo 'compile ok'; echo 'tests: 42 passed'"],
            "timeout": 120,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        { "nodeId": "report-pass", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "PIPELINE PASSED: merge allowed"] } },
        { "nodeId": "report-fail", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "PIPELINE FAILED: merge blocked"] } },
        { "nodeId": "end", "type": "CONSOLE_TERMINAL", "config": {} }
      ],
      "edges": [
        { "source": "start", "target": "tests" },
        { "source": "tests", "target": "report-pass", "sourcePort": "success" },
        { "source": "tests", "target": "report-fail", "sourcePort": "failure" },
        { "source": "report-pass", "target": "end" },
        { "source": "report-fail", "target": "end" }
      ]
    },
    "ci-fail": {
      "workflowId": "ci-fail",
      "description": "A check fails: the failure port is taken",
      "nodes": [
        { "nodeId": "start", "type": "ONE_SHOT", "config": {} },
        {
          "nodeId": "tests",
          "type": "PROCESS_EXECUTOR",
          "config": {
            "command": ["sh", "-c", "echo 'tests: 1 failed' >&2; exit 1"],
            "timeout": 120,
            "failureMode": "CONTINUE",
            "routeByExitCode": true
          }
        },
        { "nodeId": "report-pass", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "PIPELINE PASSED: merge allowed"] } },
        { "nodeId": "report-fail", "type": "PROCESS_EXECUTOR", "config": { "command": ["echo", "PIPELINE FAILED: merge blocked"] } },
        { "nodeId": "end", "type": "CONSOLE_TERMINAL", "config": {} }
      ],
      "edges": [
        { "source": "start", "target": "tests" },
        { "source": "tests", "target": "report-pass", "sourcePort": "success" },
        { "source": "tests", "target": "report-fail", "sourcePort": "failure" },
        { "source": "report-pass", "target": "end" },
        { "source": "report-fail", "target": "end" }
      ]
    }
  }
}
