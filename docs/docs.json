  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      {
        "title": "View source on GitHub",
        "description": "Open this page's source",
        "icon": "github",
        "href": "https://github.com/infenia/yukta/blob/main/docs$path.mdx"
      },
      {
        "title": "Report a docs issue",
        "description": "Open a GitHub issue about this page",
        "icon": "bug",
        "href": {
          "base": "https://github.com/infenia/yukta/issues/new",
          "query": [
            {
              "key": "title",
              "value": "docs: $path"
            }
          ]
        }
      }
    ]
  },
