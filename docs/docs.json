{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Yukta",
  "description": "Yukta runs multi-step jobs for you: describe the steps once as a flowchart, then start it from a script, a web page, a CLI or an AI assistant. Built for AI agents and automation. Technically, a reactive, DAG-based workflow orchestration server.",
  "colors": {
    "primary": "#2F6BFF",
    "light": "#6FA2FF",
    "dark": "#2F6BFF"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FBFCFE",
      "dark": "#0A0D14"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "codeblocks": "system"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg",
    "href": "/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "public": true,
            "pages": [
              "index",
              "quickstart",
              "examples"
            ]
          },
          {
            "group": "Concepts",
            "public": true,
            "pages": [
              "concepts/how-it-works",
              "concepts/sessions-and-workflows",
              "concepts/nodes-edges-ports",
              "concepts/messages",
              "concepts/executions",
              "concepts/delivery-and-backpressure",
              "concepts/failure-handling",
              "playground",
              "concepts/time-limits",
              "concepts/sub-workflows",
              "concepts/compared-with-other-tools"
            ]
          },
          {
            "group": "Build workflows",
            "public": true,
            "pages": [
              "building/defining-a-workflow",
              "building/validation-and-versions",
              "building/variables-and-expressions",
              "building/routing-and-branching",
              "building/loops-and-retries",
              "building/approvals-and-signals",
              "building/scheduling",
              "building/ai-and-agents",
              {
                "group": "Plugins",
                "public": true,
                "pages": [
                  "plugins/overview",
                  "plugins/triggers",
                  "plugins/routing-and-flow",
                  "plugins/transform",
                  "plugins/external-io",
                  "plugins/ai",
                  "plugins/decisions",
                  "plugins/terminals",
                  "plugins/writing-a-plugin"
                ]
              }
            ]
          },
          {
            "group": "Run and control",
            "public": true,
            "pages": [
              "running/run-controls",
              "running/admission-and-limits",
              "running/observability",
              "running/supervisors",
              "running/control-planes",
              "running/rule-files"
            ]
          },
          {
            "group": "Interfaces",
            "public": true,
            "pages": [
              "interfaces/web-ui",
              "interfaces/mcp",
              "interfaces/cli"
            ]
          },
          {
            "group": "Operate",
            "public": true,
            "pages": [
              "operations/configuration",
              "operations/security",
              "operations/persistence",
              "operations/checkpoints-and-resume",
              "operations/high-availability",
              "operations/remote-workers",
              "operations/deployment",
              "operations/capacity-and-performance",
              "operations/troubleshooting"
            ]
          },
          {
            "group": "Reference",
            "public": true,
            "pages": [
              "reference/glossary",
              "reference/licensing",
              "reference/limits-and-defaults",
              "reference/status-values"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "public": true,
            "pages": [
              "api/overview",
              "api/errors"
            ]
          },
          {
            "group": "Endpoints by area",
            "public": true,
            "pages": [
              "api/sessions",
              "api/workflows",
              "api/executions",
              "api/control",
              "api/streams",
              "api/catalogue"
            ]
          },
          {
            "group": "All endpoints",
            "public": true,
            "openapi": "api/openapi.json"
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "public": true,
            "pages": [
              "reference/releases"
            ]
          }
        ]
      },
      {
        "tab": "Contributing",
        "groups": [
          {
            "group": "Overview",
            "public": true,
            "pages": [
              "contributing/overview",
              "contributing/core-reference"
            ]
          },
          {
            "group": "Modules",
            "public": true,
            "pages": [
              "contributing/modules/boot",
              "contributing/modules/build-logic",
              "contributing/modules/cli",
              "contributing/modules/core",
              "contributing/modules/mcp",
              "contributing/modules/messaging",
              "contributing/modules/persistence-postgres",
              "contributing/modules/plugin-api",
              "contributing/modules/plugins",
              "contributing/modules/plus",
              "contributing/modules/ui",
              "contributing/modules/web",
              "contributing/modules/workers"
            ]
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Yukta Docs",
      "twitter:card": "summary_large_image",
      "keywords": "workflow orchestration, DAG, reactive, MCP server, AI agents, Spring Boot, CI/CD, quality gates"
    },
    "organization": {
      "name": "Infenia",
      "sameAs": ["https://github.com/infenia/yukta"]
    }
  },
  "search": {
    "prompt": "Search workflows, plugins, API…"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode",
      {
        "title": "View source on GitHub",
        "description": "Open this page's source",
        "icon": "github",
        "href": "https://github.com/infenia/yukta/blob/main/docs$path.mdx"
      },
      {
        "title": "Report a docs issue",
        "description": "Open a GitHub issue about this page",
        "icon": "bug",
        "href": {
          "base": "https://github.com/infenia/yukta/issues/new",
          "query": [
            {
              "key": "title",
              "value": "docs: $path"
            }
          ]
        }
      }
    ]
  },
