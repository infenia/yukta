{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Yukta",
  "description": "A reactive, DAG-based workflow orchestration server. Define a workflow once as JSON; run it from REST, a web UI, a CLI or an AI agent.",
  "colors": {
    "primary": "#2F6BFF",
    "light": "#6FA2FF",
    "dark": "#2F6BFF"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FBFCFE",
      "dark": "#0A0D14"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "styling": {
    "codeblocks": "system"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg",
    "href": "/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "public": true,
            "pages": [
