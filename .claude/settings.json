{
  "permissions": {
    "allow": [
      "Bash(yk check)",
      "Bash(yk check *)",
      "Bash(yk gradle *)",
      "Bash(yk watch *)",
      "Bash(yk status)",
      "Bash(yk up)",
      "Bash(yk up *)",
      "Bash(examples/11-dogfood/yk check)",
      "Bash(examples/11-dogfood/yk check *)",
      "Bash(examples/11-dogfood/yk gradle *)",
      "Bash(examples/11-dogfood/yk watch *)",
      "Bash(examples/11-dogfood/yk status)",
      "Bash(examples/11-dogfood/yk up)",
      "Bash(examples/11-dogfood/yk up *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/yk-hook.sh session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/yk-hook.sh pre-bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/yk-hook.sh stop"
          }
        ]
      }
    ]
  }
}
