{
  "permissions": {
    "allow": [
      "Bash(yk *)",
      "Bash(yk)",
      "mcp__yukta__get_execution_tree",
      "mcp__yukta__get_execution_logs",
      "mcp__yukta__get_execution_result",
      "mcp__yukta__get_workflow_status",
      "mcp__yukta__get_workflow_history",
      "mcp__yukta__get_workflow_details",
      "mcp__yukta__list_pending_inputs",
      "mcp__yukta__get_control_bus_status",
      "mcp__yukta__list_sessions",
      "mcp__yukta__get_session_details",
      "mcp__yukta__list_workflow_versions",
      "mcp__yukta__diff_workflow_versions"
    ],
    "deny": [
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/openapi.json)",
      "Read(./**/*.generated.*)",
      "Read(./**/META-INF/native-image/**/*)",
      "Read(./**/dogfood/session.json)"
    ]
  },
  "extraKnownMarketplaces": {
    "yukta": {
      "source": {
        "source": "github",
        "repo": "infenia/yukta"
      }
    },
    "yukta-dogfood": {
      "source": {
        "source": "github",
        "repo": "infenia/yukta-dogfood"
      }
    }
  },
  "enabledPlugins": {
    "yukta@yukta": true,
    "yukta-dogfood@yukta-dogfood": true
  },
  "worktree": {
    "symlinkDirectories": [
      "ui/node_modules"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)\"/scripts/dogfood-hook.sh session-start",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)\"/scripts/dogfood-hook.sh prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)\"/scripts/dogfood-hook.sh pre-bash",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)\"/scripts/dogfood-hook.sh stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
