{
  "permissions": {
    "deny": [
      "Read(./**/build/**)",
      "Read(./**/bin/**)",
      "Read(./**/.gradle/**)",
      "Read(./cli-boot/**)",
      "Read(./**/node_modules/**)"
    ],
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
