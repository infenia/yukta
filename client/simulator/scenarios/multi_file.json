{
  "name": "Multiple Files Scenario",
  "steps": [
    {
      "hook": "init",
      "data": {
        "session_id": "multi-file-session",
        "cwd": "/workspaces/yukta"
      }
    },
    {
      "hook": "save",
      "data": {
        "session_id": "multi-file-session",
        "cwd": "/workspaces/yukta",
        "tool_input": {
          "file_path": "/workspaces/yukta/src/main/java/com/example/Main.java"
        }
      }
    },
    {
      "hook": "save",
      "data": {
        "session_id": "multi-file-session",
        "cwd": "/workspaces/yukta",
        "tool_input": {
          "file_path": "/workspaces/yukta/src/main/resources/config.properties"
        }
      }
    },
    {
      "hook": "trigger",
      "data": {
        "session_id": "multi-file-session"
      }
    }
  ]
}
