<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- AssemblyContext intentionally exposes mutable collections for modification during assembly -->
  <Match>
    <Class name="com.infenia.yukta.service.orchestrator.assembly.AssemblyContext"/>
    <Or>
      <And>
        <Method name="~streams|terminals|disposables|connectors"/>
        <Bug pattern="EI_EXPOSE_REP"/>
      </And>
      <And>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
      </And>
    </Or>
  </Match>

  <!-- PluginLogEntry.metadata() returns an unmodifiable map view of frozen values -->
  <Match>
    <Class name="com.infenia.yukta.logging.api.PluginLogEntry"/>
    <Method name="metadata"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- DefaultMessage.metadata()/messageHistory() return Map.copyOf/List.copyOf results normalized
       in the compact constructor; the accessors expose already-immutable snapshots. -->
  <Match>
    <Class name="com.infenia.yukta.message.DefaultMessage"/>
    <Or>
      <Method name="metadata"/>
      <Method name="messageHistory"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- ProcessExecutionSpec.command()/env() return List.copyOf/Map.copyOf results normalized
       in the compact constructor; the accessors expose already-immutable snapshots. -->
  <Match>
    <Class name="com.infenia.yukta.plugin.process.ProcessExecutionSpec"/>
    <Or>
      <Method name="command"/>
      <Method name="env"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!-- Spring injects shared beans through constructors and setters that are meant to be held;
       the pattern is a false positive there. EI_EXPOSE_REP (returned state) stays on. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
