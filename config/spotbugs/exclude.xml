<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- AssemblyContext intentionally exposes mutable collections for modification during assembly -->
  <Match>
    <Class name="com.infenia.yukta.service.orchestrator.assembly.AssemblyContext"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- PluginLogEntry.metadata() returns an unmodifiable map view of frozen values -->
  <Match>
    <Class name="com.infenia.yukta.logging.api.PluginLogEntry"/>
    <Method name="metadata"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- ProcessExecutionSpec.command()/env() return List.copyOf/Map.copyOf results normalized
       in the compact constructor; the accessors expose already-immutable snapshots. -->
  <Match>
    <Class name="com.infenia.yukta.plugin.process.ProcessExecutionSpec"/>
    <Or>
      <Method name="command"/>
      <Method name="env"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- YuktaApplicationTest uses reflection to test private methods and manages app context lifecycle -->
  <Match>
    <Class name="com.infenia.yukta.YuktaApplicationTest"/>
  </Match>
</FindBugsFilter>
