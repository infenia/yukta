# Settings for the Yukta service, read by systemd. Restart after changing: systemctl restart yukta
# By default the server listens on 127.0.0.1 only and keeps everything in memory.

# To accept remote connections, set an address AND a key. The server refuses to start on another
# address without a key. Use a long random value.
#YUKTA_SERVER_ADDRESS=0.0.0.0
#YUKTA_API_KEY=change-me

# Keep sessions and run history across restarts (the directory is created by the service).
#YUKTA_SESSION_STORE_TYPE=file
#YUKTA_SESSION_BASE_DIR=/var/lib/yukta
#YUKTA_EXECUTION_LOG_DIR=/var/lib/yukta/log
#YUKTA_RESTART_DIR=/var/lib/yukta/checkpoints
