# Settings for the Yukta service, read by systemd. Restart after changing: systemctl restart yukta
# By default the server listens on 127.0.0.1 only and keeps everything in memory.

# To accept remote connections, set an address AND a key. The server refuses to start on another
# address without a key. Use a long random value.
#YUKTA_SERVER_ADDRESS=0.0.0.0
#YUKTA_API_KEYS_0_NAME=admin
#YUKTA_API_KEYS_0_KEY=change-me
#YUKTA_API_KEYS_0_ROLE=ADMIN

# Keep sessions and run history across restarts in PostgreSQL (needs a Plus build, made with
# -Pyukta.persistence=postgres; see docs/guides/operate/persist-sessions.mdx).
#SPRING_PROFILES_ACTIVE=prod,postgres
#SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5432/yukta
#SPRING_R2DBC_USERNAME=yukta
#SPRING_R2DBC_PASSWORD=change-me
#SPRING_FLYWAY_URL=jdbc:postgresql://localhost:5432/yukta
#SPRING_FLYWAY_USER=yukta
#SPRING_FLYWAY_PASSWORD=change-me
