[Unit]
Description=Yukta workflow orchestration server
Documentation=https://yukta.infenia.com/
After=network-online.target
Wants=network-online.target

[Service]
User=yukta
Group=yukta
EnvironmentFile=-/etc/yukta/yukta.env
ExecStart=/usr/bin/yukta
Restart=on-failure
RestartSec=5
# Longer than yukta.execution.shutdown-timeout (30 s), so running executions can finish.
TimeoutStopSec=45
# /var/lib/yukta, owned by the service user. Point the file stores at it in yukta.env.
StateDirectory=yukta
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# Workflows run user-supplied SQL, files, shell commands and expressions: give the process only what a
# server needs. Commands started by PROCESS_EXECUTOR inherit these limits.
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
# AF_NETLINK: Netty lists the network interfaces through it when the server starts.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# Valid for the native image, but a child inherits it, so it breaks a PROCESS_EXECUTOR command that
# JIT-compiles (java, node). Uncomment if workflows run no such command.
#MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
