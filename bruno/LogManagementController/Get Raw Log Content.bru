meta {
  name: Get Raw Log Content
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/logs/{{sessionId}}/{{logFilename}}/raw
  body: none
  auth: none
}

params:query {
}

headers {
  Content-Type: text/plain
}

tests {
  test("Status code should be 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("Response should contain raw text content", function() {
    if (res.getStatus() === 200) {
      expect(res.body).to.be.a('string');
    }
  });
}
