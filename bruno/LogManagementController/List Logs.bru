meta {
  name: List Logs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/logs/{{sessionId}}
  body: none
  auth: none
}

params:query {
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response should contain list of log filenames", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.be.an('array');
  });

  test("Should store first log filename for subsequent tests", function() {
    if (res.body.data && res.body.data.length > 0) {
      bru.setVar("logFilename", res.body.data[0]);
    }
  });
}
