meta {
  name: Get Workflow
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/sessions/{{sessionId}}/workflows/{{workflowId}}
  body: none
  auth: none
}

params:query {
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response should contain workflow definition", function() {
    expect(res.body).to.have.property('data');
    expect(res.body.data).to.have.property('nodes');
    expect(res.body.data).to.have.property('edges');
  });

  test("Workflow should be a valid DAG", function() {
    expect(res.body.data.nodes).to.be.an('array');
    expect(res.body.data.edges).to.be.an('array');
  });
}
