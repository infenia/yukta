meta {
  name: Get Node Heartbeat
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/control/workflows/{{workflowId}}/nodes/{{nodeId}}/heartbeat
  body: none
  auth: none
}

params:query {
}

headers {
  Content-Type: application/json
}

tests {
  test("Status code should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response should contain heartbeat information", function() {
    expect(res.body).to.have.property('data');
  });
}
