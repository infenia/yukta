meta {
  name: Answer Review
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/agent/v1/reviews/{{reviewId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{agent_token}}
}

body:json {
  { "verdict": "NO_OPINION" }
}

tests {
  test("Status code should be 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 299);
  });
}
