meta {
  name: Stream Workflow Status
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/workflow/{{sessionId}}/status/{{executionId}}/stream
  body: none
  auth: none
}

params:query {
}

headers {
  Accept: text/event-stream
}

tests {
  test("Status code should be 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Content-Type should be text/event-stream", function() {
    expect(res.getHeader('content-type')).to.include('text/event-stream');
  });
}
